#!/bin/sh
# Codex for herdr tabs and `hc run`, which start programs without a shell and so skip the mise [wrappers].
# fnox proxy run gives it placeholders and adds the real keys to its requests, as for every harness.
# hc needs --no-daemon to keep Codex's commands in hc.
# Inside an hc terminal, also passes hc's variables through shell_environment_policy.set, because
# inherit = "core" in ~/.codex/config.toml drops them from the commands Codex runs, and hc send then looks
# for the wrong socket. -c adds to the set table in config.toml. hc reads HC_SOCKET for its client socket,
# not HC_TERMINAL_SOCKET.
# Usage: hc run --bg --name fix codex-hc "task"
if [ -n "${HC_TERMINAL_ID:-}" ] && [ -n "${HC_TERMINAL_SOCKET:-}" ]; then
  set -- \
    -c "shell_environment_policy.set.HC_TERMINAL_SOCKET=\"$HC_TERMINAL_SOCKET\"" \
    -c "shell_environment_policy.set.HC_TERMINAL_ID=\"$HC_TERMINAL_ID\"" \
    ${HC_SCOPE:+-c "shell_environment_policy.set.HC_SCOPE=\"$HC_SCOPE\""} \
    ${HC_SESSION:+-c "shell_environment_policy.set.HC_SESSION=\"$HC_SESSION\""} \
    "$@"
fi
exec fnox --non-interactive proxy run -- codex --no-daemon "$@"
