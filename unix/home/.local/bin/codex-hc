#!/bin/sh
# Codex for herdr tabs and `hc run`, which start programs without a shell, so PATH has no mise wrappers dir. This
# runs the [wrappers.codex] shim by path, which starts Codex under `fnox --config <global file> proxy run` with the
# daemon off and the HC_* variables passed to the commands Codex runs: every setting and its reason is in that
# wrapper's comment in ~/.config/mise/config.toml. Kept as a name so tab argv, roll and the docs stay short.
# Usage: herdr-app do tab.new ... --argv '["codex-hc", "task"]'
exec "$HOME/.local/share/mise/command-wrappers/bin/codex" "$@"
