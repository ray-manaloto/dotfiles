# The PC over the tailnet only (tailnet-only ruling, 2026-11-11). Its machine name is private, so it lives in
# Doppler as PC_HOST and mise renders it here at apply time (the pc_host secret input in mise.toml); Tailscale
# MagicDNS resolves it, so this file names no address. ~/.ssh/config includes this folder first, and ssh keeps
# the first value it reads, so these win over any older LAN entry for the same names further down.
# The user is the local one: both machines use the same account name.
Host {{ secret(name="pc_host") }} pc
    HostName {{ secret(name="pc_host") }}
    HostKeyAlias {{ secret(name="pc_host") }}
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
