#!/usr/bin/env -S python3 -I -B
#MISE description="Watch the home volume's free space and alert below 100 GB (the disk-watch user service runs this)"
"""disk:watch: hometools disk-watch checks free space every 15 minutes and alerts when it is low."""

# A file task, so its run is not shell (AGENTS.md zero bash): this launcher only finds the hometools package in
# the checkout it is linked from and runs one command there, as tasks/herdr/doctor does. It takes no flags. The
# [bootstrap.services.disk-watch] user service in the global config runs it and keeps it running. It prints one
# JSON line per check. Exit 2 is a usage error, or hometools could not start here.

import json
import os
import sys
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/disk/watch.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"

COULD_NOT_START = 2

if sys.argv[1:]:
    sys.stderr.write(json.dumps({"error": "disk:watch takes no arguments"}) + "\n")
    raise SystemExit(COULD_NOT_START)
# The package's own environment, made by `mise run //home:sync`, runs the watch directly: -I leaves out the
# environment's PYTHON* variables, the user site and the current folder, and -B writes no bytecode.
PYTHON = PACKAGE / ".venv/bin/python"
if not (PACKAGE / ".venv/bin/hometools").is_file() or not PYTHON.exists():
    error = f"disk:watch: {PACKAGE}/.venv has no hometools; run: mise run //home:sync"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(COULD_NOT_START)
try:
    os.execv(PYTHON, [str(PYTHON), "-I", "-B", "-c", "from hometools.cli import main; main()", "disk-watch"])
except OSError as failed:
    error = f"disk:watch: hometools could not start ({PYTHON}: {failed.strerror})"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(COULD_NOT_START) from None
