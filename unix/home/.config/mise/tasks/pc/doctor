#!/usr/bin/env -S python3 -I -B
#MISE description="Check the PC against the dotfiles pc config environment over ssh, changing nothing"
"""pc:doctor: hometools pc-doctor runs mise bootstrap status and plan on the PC over ssh; it never changes anything."""

# A file task, so its run is not shell (AGENTS.md zero bash): this launcher only finds the hometools package in
# the checkout it is linked from and runs one command there, as tasks/toolchain/verify does. It takes no flags.
# The doctor prints one JSON line per check and exits 0 when every check passes, 1 when any fails and 3 when one is
# unknown and none failed (python/home/src/hometools/pcdoctor.py, the contract every pc:doctor check shares). Exit 2
# is a usage error, a bad PC_DOCTOR_TIMEOUT, or hometools could not start here.

import json
import os
import sys
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/pc/doctor.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"

COULD_NOT_START = 2

if sys.argv[1:]:
    sys.stderr.write(json.dumps({"error": "pc:doctor takes no arguments"}) + "\n")
    raise SystemExit(COULD_NOT_START)
# Read-only, as herdr:doctor: no sync and no uv, which sets up its cache on every run. The package's own
# environment, made by `mise run //home:sync`, runs the doctor directly: -I leaves out the environment's PYTHON*
# variables, the user site and the current folder, and -B writes no bytecode. Without that environment the task
# ends with one JSON error saying so.
PYTHON = PACKAGE / ".venv/bin/python"
if not (PACKAGE / ".venv/bin/hometools").is_file() or not PYTHON.exists():
    error = f"pc:doctor: {PACKAGE}/.venv has no hometools; run: mise run //home:sync"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(COULD_NOT_START)
try:
    os.execv(PYTHON, [str(PYTHON), "-I", "-B", "-c", "from hometools.cli import main; main()", "pc-doctor"])
except OSError as failed:
    error = f"pc:doctor: hometools could not start ({PYTHON}: {failed.strerror})"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(COULD_NOT_START) from None
