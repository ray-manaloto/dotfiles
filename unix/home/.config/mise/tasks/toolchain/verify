#!/usr/bin/env -S python3 -I
#MISE description="Check the held Homebrew toolchain: versions, IWYU/LLVM match, dylib links, pins (DL-595)"
#MISE env.TOOLCHAIN_BREW_PREFIX="{{ system_brew_prefix }}"
#MISE env.TOOLCHAIN_LLVM="{{ vars.llvm }}"
#MISE env.TOOLCHAIN_LLVM_MAJOR="{{ vars.llvm_major }}"
#MISE env.TOOLCHAIN_GCC="{{ vars.gcc }}"
#MISE env.TOOLCHAIN_GCC_MAJOR="{{ vars.gcc_major }}"
#MISE env.TOOLCHAIN_IWYU="{{ vars.iwyu }}"
#MISE env.TOOLCHAIN_GDB="{{ vars.gdb }}"
#MISE env.TOOLCHAIN_MAKE="{{ vars.make }}"
#MISE env.TOOLCHAIN_PKGCONF="{{ vars.pkgconf }}"
"""toolchain:verify: hometools toolchain-verify checks the held Homebrew toolchain and the P2996 links."""

# A file task, so its run is not shell (AGENTS.md zero bash): this launcher only finds the hometools package
# in the checkout it is linked from and runs one command there. The #MISE env lines render [vars] and the brew
# prefix as the TOML task's templates did; a caller's own TOOLCHAIN_* value is replaced, never read.

import json
import os
import subprocess
import sys
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/toolchain/verify.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"

COULD_NOT_START = 2

# The package's environment is synced as its own step first, so a uv that fails or can't start there ends
# the task with one JSON error naming it and exit 2. A failed toolchain-verify exits 1
# (python/home/src/hometools/cli.py:28), as uv does on a stale or missing lock (uv 0.13.7
# crates/uv/src/lib.rs:3149-3152). hometools exits 2 only on argparse's usage error (Python 3.15.0
# Lib/argparse.py:2958), and this launcher always passes it a command it knows.
# --inexact keeps packages the lock doesn't list, as uv run did: uv sync removes them by default
# (uv 0.13.7 crates/uv-cli/src/settings.rs:851-855 for run, 2003-2007 for sync).
try:
    synced = subprocess.run(["uv", "sync", "--project", str(PACKAGE), "--locked", "--inexact"], check=False).returncode
except OSError as failed:
    synced, why = 127, f"uv: {failed.strerror}"
else:
    # A signal's death is -N here; the shell's status is 128 + N.
    synced = synced if synced >= 0 else 128 - synced
    why = f"uv sync exited {synced}"
if synced:
    error = f"toolchain:verify: hometools could not start ({why})"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(COULD_NOT_START)
os.execvp("uv", ["uv", "run", "--project", str(PACKAGE), "--no-sync", "hometools", "toolchain-verify"])
