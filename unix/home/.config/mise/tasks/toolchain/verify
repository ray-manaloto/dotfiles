#!/usr/bin/env -S python3 -I
#MISE description="Check the held Homebrew toolchain: versions, IWYU/LLVM match, dylib links, pins (DL-595)"
#MISE env.TOOLCHAIN_BREW_PREFIX="{{ system_brew_prefix }}"
#MISE env.TOOLCHAIN_LLVM="{{ vars.llvm }}"
#MISE env.TOOLCHAIN_LLVM_MAJOR="{{ vars.llvm_major }}"
#MISE env.TOOLCHAIN_GCC="{{ vars.gcc }}"
#MISE env.TOOLCHAIN_GCC_MAJOR="{{ vars.gcc_major }}"
#MISE env.TOOLCHAIN_IWYU="{{ vars.iwyu }}"
#MISE env.TOOLCHAIN_GDB="{{ vars.gdb }}"
#MISE env.TOOLCHAIN_MAKE="{{ vars.make }}"
#MISE env.TOOLCHAIN_PKGCONF="{{ vars.pkgconf }}"
"""toolchain:verify: hometools toolchain-verify checks the held Homebrew toolchain and the P2996 links."""

# A file task, so its run is not shell (AGENTS.md zero bash): this launcher only finds the hometools package
# in the checkout it is linked from and runs one command there. The #MISE env lines render [vars] and the brew
# prefix as the TOML task's templates did; a caller's own TOOLCHAIN_* value is replaced, never read.

import os
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/toolchain/verify.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"
os.execvp("uv", ["uv", "run", "--project", str(PACKAGE), "--locked", "hometools", "toolchain-verify"])
