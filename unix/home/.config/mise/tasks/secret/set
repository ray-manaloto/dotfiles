#!/usr/bin/env -S python3 -I
#MISE description="store one NEW Doppler secret in dotfiles/dev_personal, its value piped on stdin"
# raw: the piped value must reach hometools; mise connects stdin to a task that may get redacted output only
# when raw (mise 2026.11.6 src/task/task_executor.rs:2514-2523).
#MISE raw=true
#USAGE arg "<name>" help="the secret's UPPER_SNAKE name; it must not exist in Doppler yet"
"""secret:set NAME: hometools secret-set sends the piped value to Doppler under the owner's write token."""

# A file task, so its run is not shell (AGENTS.md zero bash): this launcher only finds the hometools package in the
# checkout it is linked from and runs one command there. Never `fnox set` on a doppler provider: fnox writes the
# value into the TOML in plain text (agents AGENTS.md, "Adding a Doppler secret").
# Example: pbpaste | mise run secret:set EXAMPLE_API_KEY

import json
import os
import subprocess
import sys
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/secret/set.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"

# The package's environment is synced as its own step first, with stdin closed to it: the value on stdin is
# hometools' alone. --inexact keeps packages the lock doesn't list, as uv run did (update:check says why).
try:
    synced = subprocess.run(
        ["uv", "sync", "--project", str(PACKAGE), "--locked", "--inexact"], stdin=subprocess.DEVNULL, check=False
    ).returncode
except OSError as failed:
    synced, why = 127, f"uv: {failed.strerror}"
else:
    # A signal's death is -N here; the shell's status is 128 + N.
    synced = synced if synced >= 0 else 128 - synced
    why = f"uv sync exited {synced}"
if synced:
    error = f"secret:set: hometools could not start ({why})"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(synced)
os.execvp("uv", ["uv", "run", "--project", str(PACKAGE), "--no-sync", "hometools", "secret-set", *sys.argv[1:]])
