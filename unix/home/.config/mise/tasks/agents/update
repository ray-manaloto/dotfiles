#!/usr/bin/env -S python3 -I
#MISE description="Update the native agent CLIs (claude, codex, agy, opencode); install any that are missing"
#USAGE flag "--skip <cli>" var=#true help="Leave this CLI alone (claude, codex, agy or opencode); repeat it or separate names with commas"
"""Each agent CLI updates itself, and mise never manages these.

Only the native install path counts, so a copy elsewhere on PATH is ignored and
`opencode upgrade` keeps detecting its curl install. Each installer is downloaded to a
file first, so a cut-off download never runs. An OpenCode 1 install is replaced with the
v2 installer, because its own updater stays on major version 1. Each download and each
command gets AGENTS_UPDATE_TIMEOUT seconds (default 600), including any time a prompt
waits for an answer, after which it is stopped with every process it started. A CLI that
fails or times out is reported as one JSON error event on stderr, the others still run,
and the task exits 1. Ctrl-C cancels the whole run. --skip leaves the named CLIs alone:
roll:update skips OpenCode while an OpenCode session it leaves running uses the binary.
"""

import argparse
import contextlib
import json
import os
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

# name: (native path under HOME, installer URL, the shell the installer is written for,
# installer arguments, installer environment)
AGENTS = {
    "claude": (".local/bin/claude", "https://claude.ai/install.sh", "bash", [], {}),
    "codex": (
        ".local/bin/codex",
        "https://chatgpt.com/codex/install.sh",
        "sh",
        [],
        {"CODEX_NON_INTERACTIVE": "1"},
    ),
    "agy": (
        ".local/bin/agy",
        "https://antigravity.google/cli/install.sh",
        "bash",
        [],
        {},
    ),
    "opencode": (
        ".opencode/bin/opencode",
        "https://opencode.ai/v2/install",
        "bash",
        ["--no-modify-path"],
        {},
    ),
}


# Seconds each download and each command may take before that CLI counts as failed.
TIMEOUT = int(os.environ.get("AGENTS_UPDATE_TIMEOUT", "600"))


def terminal() -> int | None:
    """The controlling terminal, open, when this task is in its foreground; else None."""
    try:
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:  # no controlling terminal (CI, a test, a background job)
        return None
    if os.tcgetpgrp(fd) == os.getpgrp():
        return fd
    os.close(fd)
    return None


def give_terminal(fd: int, group: int) -> None:
    """Put a process group in the terminal's foreground, as a shell does for a job."""
    # Doing this from a background group raises SIGTTOU, which would stop this task.
    previous = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    try:
        os.tcsetpgrp(fd, group)
    finally:
        signal.signal(signal.SIGTTOU, previous)


def run(
    argv: list[str | Path], env: dict[str, str] | None = None, *, capture: bool = False
) -> str:
    """Run argv in its own process group and return what it printed when captured. While it
    runs, its group has the terminal, so its prompts can be answered. Past TIMEOUT, or on an
    interrupt, the whole group is killed, so a vendor installer's children stop with it, and
    TimeoutExpired or KeyboardInterrupt is raised; a non-zero exit raises CalledProcessError."""
    tty = terminal()
    try:
        with subprocess.Popen(
            argv,
            env=env,
            stdout=subprocess.PIPE if capture else None,
            text=True,
            process_group=0,
        ) as process:
            try:
                if tty is not None:
                    # The group is gone if the command already exited.
                    with contextlib.suppress(ProcessLookupError, PermissionError):
                        give_terminal(tty, process.pid)
                        # A read of the terminal before the hand-over stopped it on SIGTTIN.
                        os.killpg(process.pid, signal.SIGCONT)
                out, _ = process.communicate(timeout=TIMEOUT)
            # Past TIMEOUT, or interrupted while its group, without the terminal, got no signal.
            except BaseException:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGKILL)
                process.communicate()
                raise
    finally:
        if tty is not None:
            give_terminal(tty, os.getpgrp())
            os.close(tty)
    # Ctrl-C reaches only the group holding the terminal; it cancels the whole run.
    if process.returncode in (-signal.SIGINT, 128 + signal.SIGINT):
        raise KeyboardInterrupt
    if process.returncode:
        raise subprocess.CalledProcessError(process.returncode, argv, out)
    return out or ""


def install(url: str, shell: str, args: list[str], env: dict[str, str]) -> None:
    """Download the vendor installer to a file, then run it."""
    with tempfile.TemporaryDirectory() as temp:
        script = Path(temp) / "install"
        # curl also ends a stalled download itself at --max-time and exits non-zero.
        run(["curl", "-fsSL", "--max-time", str(TIMEOUT), "-o", str(script), url])
        run([shell, str(script), *args], os.environ | env)


def major_version(binary: Path) -> str:
    """`opencode --version` prints `1.19.0` or `opencode v2.2.5`; return the major number."""
    words = run([binary, "--version"], capture=True).split()
    return words[-1].removeprefix("v").split(".")[0] if words else ""


def skipped(argv: list[str]) -> set[str]:
    """The CLIs --skip names; an unknown name exits 2 before anything runs."""
    parser = argparse.ArgumentParser(prog="agents:update")
    parser.add_argument("--skip", action="append", default=[])
    names = {name.strip() for value in parser.parse_args(argv).skip for name in value.split(",") if name.strip()}
    if unknown := names - set(AGENTS):
        parser.error(f"--skip: unknown {sorted(unknown)}; choose from {sorted(AGENTS)}")
    return names


def main(argv: list[str]) -> int:
    skip = skipped(argv)
    home = Path.home()
    # Installers skip their own shell-profile edits when their folder is already on PATH.
    os.environ["PATH"] = os.pathsep.join(
        [
            str(home / ".local/bin"),
            str(home / ".opencode/bin"),
            os.environ.get("PATH", ""),
        ]
    )
    failed = False
    for name, (path, url, shell, args, env) in AGENTS.items():
        if name in skip:
            print(json.dumps({"event": "agent_skipped", "agent": name}), file=sys.stderr)
            continue
        binary = home / path
        try:
            missing = not os.access(binary, os.X_OK)
            if missing or (name == "opencode" and major_version(binary) == "1"):
                install(url, shell, args, env)
            else:
                run([binary, "update"])
        # Ctrl-C: stop here, so no later CLI changes.
        except KeyboardInterrupt:
            event = {"event": "agents_update_cancelled", "agent": name}
            print(json.dumps(event), file=sys.stderr)
            return 128 + signal.SIGINT
        # A command that could not start, exited non-zero or ran past TIMEOUT: one CLI
        # failed, the rest go on.
        except (
            OSError,
            subprocess.CalledProcessError,
            subprocess.TimeoutExpired,
        ) as error:
            event = {"event": "agent_failed", "agent": name, "error": str(error)}
            print(json.dumps(event), file=sys.stderr)
            failed = True
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
