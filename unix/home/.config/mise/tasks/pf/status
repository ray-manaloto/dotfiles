#!/usr/bin/env -S python3 -I
#MISE description="check pf is on with the Tailscale-only rules loaded; asks for sudo"
"""pf:status: hometools pf-status prints one JSON line and exits 1 unless pf, the rules and the boot daemon are all on."""

# A file task, so its run is not shell (AGENTS.md zero bash): this launcher only finds the hometools package in the
# checkout it is linked from and runs one command there, as tasks/update/brew does. The rules and the boot daemon
# are mise [bootstrap.files] in the global config; docs/research/pf-tailnet.md has the design.

import json
import os
import subprocess
import sys
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/pf/status.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"

# --inexact keeps packages the lock doesn't list, as uv run did (tasks/update/brew says why).
try:
    synced = subprocess.run(["uv", "sync", "--project", str(PACKAGE), "--locked", "--inexact"], check=False).returncode
except OSError as failed:
    synced, why = 127, f"uv: {failed.strerror}"
else:
    # A signal's death is -N here; the shell's status is 128 + N.
    synced = synced if synced >= 0 else 128 - synced
    why = f"uv sync exited {synced}"
if synced:
    error = f"pf:status: hometools could not start ({why})"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(synced)
os.execvp("uv", ["uv", "run", "--project", str(PACKAGE), "--no-sync", "hometools", "pf-status"])
