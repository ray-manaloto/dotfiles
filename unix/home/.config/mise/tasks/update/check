#!/usr/bin/env -S python3 -I
#MISE description="structured, read-only: what is outdated? (exit 1 if anything is)"
"""update:check: hometools update-check prints what brew and mise find outdated; exits 0, 1 on drift, 2 unchecked."""

# A file task, so its run is not shell (AGENTS.md zero bash, #392): this launcher only finds the hometools
# package in the checkout it is linked from and runs one command there. Nothing is installed or upgraded.

import json
import os
import subprocess
import sys
from pathlib import Path

# ~/.config/mise/tasks links to <checkout>/unix/home/.config/mise/tasks; this file is tasks/update/check.
PACKAGE = Path(__file__).resolve().parents[6] / "python/home"
COULD_NOT_CHECK = 2

# uv exits 1 on a user error such as a stale or missing lock (uv 0.13.7 crates/uv/src/lib.rs:3149-3152,
# crates/uv-command-support/src/lib.rs:82), and 1 is update:check's drift. So the package's environment is synced
# as its own step first: a uv that fails or can't start there is COULD NOT CHECK, and the run below doesn't sync.
# --inexact keeps packages the lock doesn't list, as uv run did: uv sync removes them by default
# (uv 0.13.7 crates/uv-cli/src/settings.rs:851-855 for run, 2003-2007 for sync).
try:
    synced = subprocess.run(["uv", "sync", "--project", str(PACKAGE), "--locked", "--inexact"], check=False).returncode
except OSError as failed:
    synced, why = 127, f"uv: {failed.strerror}"
else:
    why = f"uv sync exited {synced}"
if synced:
    error = f"update:check: hometools could not start ({why}) — COULD NOT CHECK"
    sys.stderr.write(json.dumps({"error": error}) + "\n")
    raise SystemExit(COULD_NOT_CHECK)
os.execvp("uv", ["uv", "run", "--project", str(PACKAGE), "--no-sync", "hometools", "update-check"])
