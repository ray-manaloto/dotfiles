# Allowlist: everything is ignored unless named here, so a stray key or
# secret file in the checkout is never staged by accident.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/CODING_STANDARDS.md
!/GLOSSARY.md
!/cmake/
!/docs/
!/doctor/
!/hk.pkl
# agnix's config for the hk agnix step (docs/research/agent-config-linters.md).
!/.agnix.toml
!/mise.lock
!/mise.toml
!/cpp/
!/python/
!/swift/
!/tests/
!/unix/
# The dotfiles Claude Code marketplace and its plugins (typescript-native-lsp).
!/.claude-plugin/
!/plugins/
# The project's settings and /verify skill; settings.local.json and anything else under .claude stay out.
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/verify/

# The PC runner's smoke workflow; no other workflow is tracked.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pc-smoke.yml

# Build and environment outputs inside the allowed roots.
/cpp/build/
/swift/.build/
/swift/.swiftpm/
/python/.venv/
/python/toolchains/p2996/.venv/
# python/repo and python/workflow moved to cpp-standard (its #157); these keep the venvs older checkouts still hold
# ignored, so those checkouts stay clean for pr-merge.
/python/repo/.venv/
/python/workflow/.venv/
/python/home/.venv/
/python/visualplan/.venv/
/python/jbctl/.venv/
/python/guards/.venv/
__pycache__/
.coverage
# A subprocess writes its own .coverage.<host>.pid<n>.<random> until pytest-cov combines them.
.coverage.*
