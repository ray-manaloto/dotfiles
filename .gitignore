# Allowlist: everything is ignored unless named here, so a stray key or
# secret file in the checkout is never staged by accident.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/CODING_STANDARDS.md
!/cmake/
!/fnox.toml
!/hk.pkl
!/mise.lock
!/mise.toml
!/cpp/
!/python/
!/tasks/
!/tests/
!/typescript/
!/unix/
# Only the project's /verify skill; settings.local.json and anything else under .claude stay out.
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/verify/

# Build and environment outputs inside the allowed roots.
/cpp/build/
/python/.venv/
/python/toolchains/p2996/.venv/
/python/repo/.venv/
/typescript/node_modules/
__pycache__/
.coverage
