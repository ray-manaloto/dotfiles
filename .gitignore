# Logs
*.log
firebase-debug.log

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Docker/DevContainer local state
.devcontainer/local-state/
# Per-machine feature-lock generated by `@devcontainers/cli` on `up`/rebuild.
# The sshd feature is already pinned via `:1` (+ AGENTS.md notes 1.1.0); this
# digest-lock churns per-machine, so keep it out of the repo.
.devcontainer/devcontainer-lock.json

# Git worktrees
.worktrees/

# IDEs
.idea/
.vscode/

# mise auto-generated state
.mise/

# mise per-clone overrides (see mise.local.toml.example)
mise.local.toml
mise.*.local.toml

# Claude Code per-clone permission allowlist (accumulates session tool-use approvals)
.claude/settings.local.json

# OMC/OMG/OMX plugin state
.omg/
.agent/state/
# Transient working notepad — agents edit it mid-work, so tracking it dirtied
# the tree and tripped `mise run ship`'s clean-tree gate (forcing stash dances).
# Durable findings live in GH issues + `docs/research/`, not here.
.agent/notepad.md
# Regenerated every session by the SessionEnd command-audit hook (settings.json)
# and derived from LOCAL ~/.claude transcripts, so it is per-clone by nature —
# same clean-tree rationale as the notepad above. `.agent/` is ignored via
# this clone's .git/info/exclude, which a fresh clone does not get.
.agent/command-audit.md
.omx/

# Codex CLI temporary state
.codex/*
!.codex/hooks.json

# Logging
.logging/

# Maestro Session State (Keep plans, ignore active state)
docs/maestro/state/active-session.md
docs/maestro/state/archive/

# graphify knowledge-graph outputs (#310): ignore large/regenerable, keep only the shareable wiki
graphify-out/
!graphify-out/wiki/

# graphify per-install state (generated by `graphify install`/runs; not source)
.claude/skills/graphify/.graphify_version
.claude/skills/**/.graphify_root

# Cross-repo parity checkout (#354): CI clones knowledge-base inside the
# workspace because actions/checkout refuses a path outside it. Never source.
.parity/

# --- Agent working state -----------------------------------------------------
# `.agent/` replaces `.agent/` (2026-07-25): that tree was named for the
# oh-my-claudecode plugin, which is not enabled here. Ignored via THIS file, not
# `.git/info/exclude` — the old per-clone exclusion did not survive a fresh
# clone, which is exactly why the artifacts we DID want tracked had to be
# force-added with `git add -f`. Durable artifacts now live in `docs/`.
.agent/
# `.agent/` stays ignored even though nothing here writes it any more: the
# statusline HUD in the USER-level ~/.claude/settings.json
# (`node $HOME/.claude/hud/omc-hud.mjs`) recreates `.agent/state/` in whichever
# repo is cwd, within seconds of deletion. Retiring it is a user-config change
# this repo does not make unasked.
.agent/
