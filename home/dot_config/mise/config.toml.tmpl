#:schema https://mise.jdx.dev/schema/mise.json

# Devcontainer-only mise overlay (gated by .chezmoiignore on chezmoi.os == "linux").
# OVERLAY TIER (#160 T9): interactive session tools installed PER-USER onto
# the home volume (~/.local/share/mise), eager-installed by onCreateCommand
# (on-create.sh) so they are present on first shell. Free on "latest" by
# design — no lockfile; they are session conveniences, not build inputs, and
# keeping them out of the image keeps the base/runtime content-hashes stable.
# Locked build/dev tools live in .devcontainer/mise-system.toml (base tier)
# and .devcontainer/mise-runtime.toml (runtime tier).

[tools]
# File/search/navigation
fzf = "latest"
ripgrep = "latest"
fd = "latest"
bat = "latest"
vivid = "latest"
eza = "latest"
lsd = "latest"
zoxide = "latest"
yazi = "latest"
"conda:tree" = "latest"
"conda:broot" = "latest"
# Monitors & inspectors
"conda:htop" = "latest"
btop = "latest"
"conda:procs" = "latest"
"conda:ncdu" = "latest"
dust = "latest"
tokei = "latest"
hexyl = "latest"
"conda:hyperfine" = "latest"
# Terminal & shell UX
starship = "latest"
zellij = "latest"
"conda:tealdeer" = "latest"
glow = "latest"
"conda:vim" = "latest"
# Git UIs
gitui = "latest"
lazygit = "latest"
# HTTP clients
"conda:HTTPie" = "latest"
xh = "latest"

[settings]
activate_aggressive = true
auto_install = true
experimental = true
#verbose = true

[settings.status]
show_tools = true
missing_tools = "always"
show_env = true

[tasks."update:all"]
description = "update all tools and reshim"
run = """
set -euo pipefail
mise activate
sudo mise config ls
sudo mise self-update -y
sudo mise upgrade --bump -- --system -y
sudo mise install --system -y
sudo mise install -y
sudo mise reshim -f -y
sudo mise outdated -y
sudo mise doctor -y
"""
