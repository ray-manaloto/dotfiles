l":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":95208951,"digest":"sha256:db8c858191bf9fb9f0e394aa72b591a15e51d13f2c86ae3f141a4c5820e3124f","download_count":204,"created_at":"2026-09-01T17:10:14Z","updated_at":"2026-09-01T17:10:23Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.257/claude-linux-arm64.tar.gz"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/539876180","id":539876180,"node_id":"RA_kwDON91aY84gLdtU","name":"claude-linux-x64-musl.tar.gz","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":93256786,"digest":"sha256:78a7aa66a06e227b07d85f721d5214a5ce380f527f69e9037d0734ca1741eece","download_count":25,"created_at":"2026-09-01T17:10:14Z","updated_at":