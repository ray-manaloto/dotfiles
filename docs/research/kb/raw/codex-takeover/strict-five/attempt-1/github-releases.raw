30Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.174/SHASUMS256.txt"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/445097843","id":445097843,"node_id":"RA_kwDON91aY84ah6dz","name":"SHASUMS256.txt.sig","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/pgp-signature","state":"uploaded","size":833,"digest":"sha256:a8ec62d51f53b8d06e183fd69b951fbfe99e090371b0fb5fd93b4dd34283db4e","download_count":34,"created_at":"2026-06-11T22:25:29Z","updated_at":"2026-06-11T22:25:30Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.174/SHASUMS256.txt.sig"}],"tarball_url":"https://api.github.com/repos/anthropics/claude-code/tarball/v2.1.174","zipball_url":"https://api.github.com/repos/anthropics/claude-code/zipball/v2.1.174","body":"## What's changed\n\n- Added `wheelScrollAccelerationEnabled` setting to disable mouse-wheel scroll acceleration in fullscreen mode\n- Fixed the `/model` picker hiding the model family that Default resolves to — Opus now appears as its own row on Max/Team Premium/Enterprise plans, Sonnet on Pro/Team plans, and Opus on pay-as-you-go API accounts\n- Fixed `/model` picker showing a hardcoded Sonnet version label when `ANTHROPIC_DEFAULT_SONNET_MODEL` pins a different Sonnet\n- Fixed the \"Fable 5 is now consuming usage credits\" banner incorrectly showing for enterprise accounts with usage-based billing\n- Fixed Bedrock GovCloud regions (`us-gov-*`) deriving the wrong inference profile prefix (`global` instead of `us-gov`), causing 400 errors on derived model IDs\n- Fixed background sessions inheriting another session's `ANTHROPIC_*` provider env (gateway URL, custom headers, `/model` aliases) from the shell that started the background daemon\n- Fixed a 1-2 second pause when exiting Claude Code shortly after a shell command was interrupted or killed on macOS and Linux\n- Fixed git commit co-author attribution showing an incorrect model name for some models\n- Fixed the `/advisor` dialog pre-selecting a saved advisor model that is blocked by the `availableModels` allowlist\n- Fixed skill hot-reload re-sending the entire skill listing when a single skill changed; only changed skills are now re-announced\n- Fixed Workflow tool `agent()` subagents missing per-agent attribution headers\n- [VSCode] Added usage attribution to the Account & usage dialog (`/usage`) showing cache misses, long context, subagents, and per-skill/agent/plugin/MCP breakdowns over the last 24h or 7d\n- Fixed pre-warmed background workers failing with \"Could not resolve authentication method\" when claimed after sitting idle\n","reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/releases/338280944/reactions","total_count":30,"+1":11,"-1":0,"laugh":2,"hooray":4,"confused":0,"heart":6,"rocket":4,"eyes":3}},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/337625010","assets_url":"https://api.github.com/repos/anthropics/claude-code/releases/337625010/assets","upload_url"