","state":"uploaded","size":734,"digest":"sha256:a90eefa3dcad41b3a46f5a63e1c393324b6a650b05398dd9d84769f01b0de84c","download_count":206,"created_at":"2026-08-10T20:52:51Z","updated_at":"2026-08-10T20:52:51Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.227/SHASUMS256.txt"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/509246783","id":509246783,"node_id":"RA_kwDON91aY84eWn0_","name":"SHASUMS256.txt.sig","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/pgp-signature","state":"uploaded","size":833,"digest":"sha256:2a568fe1d9da8913bc941a4f043680b790f0025f7478d1ddca5f78f7e9cf46c2","download_count":37,"created_at":"2026-08-10T20:52:51Z","updated_at":"2026-08-10T20:52:51Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.227/SHASUMS256.txt.sig"}],"tarball_url":"https://api.github.com/repos/anthropics/claude-code/tarball/v2.1.227","zipball_url":"https://api.github.com/repos/anthropics/claude-code/zipball/v2.1.227","body":"## What's changed\n\n- Fixed feature flags being evaluated without the user's subscription tier when a session started with an expired login token, which could wrongly prompt Max plan users to enable usage credits for Fable\n- Fixed every Bash command failing under `claude-code-action` with `allowed_non_write_users` on GitHub-hosted runners\n- Fixed `/tui` bringing back a conversation that had been rewound to before its first message\n- Improved slash-command menu: blue now marks only the selected row, matched characters are bolded instead of recolored, and emoji or accented names keep their glyphs\n- Improved performance: fewer event-loop stalls on file-not-found suggestions and at-mention size checks\n","reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/releases/368190806/reactions","total_count":39,"+1":13,"-1":0,"laugh":5,"hooray":5,"confused":0,"heart":5,"rocket":6,"eyes":5}},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/367079935","assets_url":"https://api.github.com/repos/anthropics/claude-code/releases/367079935/assets","upload_url":"https://uploads.github.com/repos/anthropics/claude-code/releases/367079935/assets{?name,label}","html_url":"https://github.com/anthropics/claude-code/releases/tag/v2.1.226","id":367079935,"author":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.g