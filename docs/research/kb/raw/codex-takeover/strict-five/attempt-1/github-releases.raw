3Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.266/SHASUMS256.txt"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/551525655","id":551525655,"node_id":"RA_kwDON91aY84g350X","name":"SHASUMS256.txt.sig","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/pgp-signature","state":"uploaded","size":833,"digest":"sha256:1a8f2706514ca45954893d9a9641c9b9ce7a21229d4a3f5c1f80b360faaab877","download_count":29,"created_at":"2026-09-08T23:28:53Z","updated_at":"2026-09-08T23:28:54Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.266/SHASUMS256.txt.sig"}],"tarball_url":"https://api.github.com/repos/anthropics/claude-code/tarball/v2.1.266","zipball_url":"https://api.github.com/repos/anthropics/claude-code/zipball/v2.1.266","body":"## What's changed\n\n- Fixed a 2.1.265 regression affecting LLM-gateway and proxy setups: the undocumented `CLAUDE_CODE_USE_GATEWAY` environment variable, previously ignored unless `ANTHROPIC_BASE_URL` and `ANTHROPIC_AUTH_TOKEN` were both set, began forcing Cloud-gateway sign-in on its own in 2.1.265, so configurations that set it alongside an API key, `apiKeyHelper`, or custom auth headers failed every request with \"Not signed in to the Cloud gateway\". The variable on its own is ignored again; no configuration change is needed\n","reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/releases/385124520/reactions","total_count":37,"+1":14,"-1":0,"laugh":4,"hooray":4,"confused":0,"heart":5,"rocket":6,"eyes":4}},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/384990084","assets_url":"https://api.github.com/repos/anthropics/claude-code/releases/384990084/assets","upload_url":"https://uploads.github.com/repos/anthropics/claude-code/releases/384990084/assets{?name,label}","html_url":"https://github.com/anthropics/claude-code/releases/tag/v2.1.265","id":384990084,"author":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDON91aY84W8nuE","tag_name":"v2.1.265","target_commitish":"main","name":"v2.1.265","draft":false,"immutable":false,"pre