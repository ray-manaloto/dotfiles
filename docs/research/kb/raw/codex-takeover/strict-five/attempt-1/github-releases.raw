ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"text/plain; charset=utf-8","state":"uploaded","size":734,"digest":"sha256:8325f509f09ead9bc54db7a09507be7a19e18d937f704614bb8fb96e407eb2b1","download_count":190,"created_at":"2026-06-25T19:03:11Z","updated_at":"2026-06-25T19:03:11Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.193/SHASUMS256.txt"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/457910527","id":457910527,"node_id":"RA_kwDON91aY84bSyj_","name":"SHASUMS256.txt.sig","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/pgp-signature","state":"uploaded","size":833,"digest":"sha256:ed9131ea27cab7586b66aff8971f531b3f7f432da3185d653bb62a9cff72b140","download_count":189,"created_at":"2026-06-25T19:03:11Z","updated_at":"2026-06-25T19:03:12Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.193/SHASUMS256.txt.sig"}],"tarball_url":"https://api.github.com/repos/anthropics/claude-code/tarball/v2.1.193","zipball_url":"https://api.github.com/repos/anthropics/claude-code/zipball/v2.1.193","body":"## What's changed\n\n- Added `autoMode.classifyAllShell` setting to route all Bash/PowerShell commands through the auto-mode classifier instead of only arbitrary-code-execution patterns\n- Added auto-mode denial reasons to the transcript, the denial toast, and `/permissions` recent denials\n- Added `claude_code.assistant_response` OpenTelemetry log event containing the model's response text. Redacted unless `OTEL_LOG_ASSISTANT_RESPONSES=1`; when that var is unset it follows `OTEL_LOG_USER_PROMPTS`, so deployments that already log prompt content will start receiving response content on upgrade — set `OTEL_LOG_ASSISTANT_RESPONSES=0` to keep prompts-only.\n- Added live file path autocomplete to bash mode (`!`)\n- Added a startup notice when MCP servers need authentication, pointing at `/mcp`\n- Added automatic memory-pressure reaping for idle background shell commands (disable with `CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP=1`)\n- Fixed `/model` and other client-data-gated UI showing stale/empty state immediately after `/login`\n- Fixed backgrounding (←←) spuriously cancelling with \"N background tasks would be abandoned\" when all running tasks carry over to the new session\n- Fixed pinned background agents being re-prompted to \"Continue from where you left off\" after every auto-update\n- Fixed backgrounding the main turn spawning a phantom \"general-purpose (resumed)\" subagent that re-ran the main conversation\n- Fixed agent panel hiding sibling agents when viewing a subagent\n- Improved background agents: the launch result no longer instructs Claude to \"end your response\" — it keeps working on other tasks while the agent runs\n- Improved MCP `headersHelper` auth: the helper now re-runs and reconnects automatically when a tool call returns 401/403\n- Improved plugin auto-rename: marketplace `renames` maps are now followed automatically, updating your settings to the new name\n- Improved `/add-dir` message when the directory is already a working directory\n","reactions":{"url":"https://api.github.com/repos/anthropics/claude-code/releases/344922230/reactions","total_count":40,"+1":12,"-1":0,"laugh":4,"hooray":9,"confused":0,"heart":3,"rocket":7,"eyes":5}},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/344307226","assets_url":"https://api.github.com/repos/anthropics/claude-code/releases/344307226/assets","upload_url":"https://uploads.github.com/repos/anthropics/claude-code/releases/344307226/assets{?name,label}","html_url":"https://github.com/anthropics/claude-code/releases/tag/v2.1.191","id":344307226,"author":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDON91aY84UhbYa","tag_name":"v2.1.191","target_commitish":"main","name":"v2.1.191","draft":false,"immutable":false,"prerelease":false,"created_at":"2026-06-24T21:58:06Z","updated_at":"2