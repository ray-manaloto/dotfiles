/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":102687084,"digest":"sha256:e6b43215da3ac8c27904df64d027acb150b7015920ba08a807fd3ff678a4f3c7","download_count":49,"created_at":"2026-09-23T16:59:15Z","updated_at":"2026-09-23T16:59:20Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.281/claude-linux-arm64-musl.tar.gz"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/584208622","id":584208622,"node_id":"RA_kwDON91aY84i0lDu","name":"claude-linux-arm64.tar.gz","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":105082141,"digest":"sha256:f4ffa7230f09882977b1195a5f5343fea1443027858d1c1fa1ea82e921517cd0","download_count":855,"created_at":"2026-09-23T16:59:15Z","updated_at":"2026-09-23T16:59:20Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.281/claude-linux-arm64.tar.gz"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/584208626","id":584208626,"node_id":"RA_kwDON91aY84i0lDy","name":"claude-linux-x64-musl.tar.gz","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":103211386,"digest":"sha256:f3f57b79f1cd70b7ed159de86ecccfea51c51e554f06bfec054b86df9fe21550","download_count":96,"created_at":"2026-09-23T16:59:15Z","updated_at":"2026-09-23T16:59:19Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.281/claude-linux-x64-musl.tar.gz"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/584208766","id":584208766,"node_id":"RA_kwDON91aY84i0lF-","name":"claude-linux-x64.tar.gz","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","followers_url":"https://api.github.com/users/ashwin-ant/followers","following_url":"https://api.github.com/users/ashwin-ant/following{/other_user}","gists_url":"https://api.github.com/users/ashwin-ant/gists{/gist_id}","starred_url":"https://api.github.com/users/ashwin-ant/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ashwin-ant/subscriptions","organizations_url":"https://api.github.com/users/ashwin-ant/orgs","repos_url":"https://api.github.com/users/ashwin-ant/repos","events_url":"https://api.github.com/users/ashwin-ant/events{/privacy}","received_events_url":"https://api.github.com/users/ashwin-ant/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/x-gtar","state":"uploaded","size":105423188,"digest":"sha256:0a3d25f34f0a733fe23f34ecde87dc5bdebd2ccc457fb2d446ae33d6eb75f3d7","download_count":13430,"created_at":"2026-09-23T16:59:20Z","updated_at":"2026-09-23T16:59:24Z","browser_download_url":"https://github.com/anthropics/claude-code/releases/download/v2.1.281/claude-linux-x64.tar.gz"},{"url":"https://api.github.com/repos/anthropics/claude-code/releases/assets/584208780","id":584208780,"node_id":"RA_kwDON91aY84i0lGM","name":"claude-win32-arm64.zip","label":"","uploader":{"login":"ashwin-ant","id":178951676,"node_id":"U_kgDOCqqV_A","avatar_url":"https://avatars.githubusercontent.com/u/178951676?v=4","gravatar_id":"","url":"https://api.github.com/users/ashwin-ant","html_url":"https://github.com/ashwin-ant","fol