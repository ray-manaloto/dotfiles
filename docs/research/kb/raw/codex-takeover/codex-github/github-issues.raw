ll,\n      \"durationMs\": 28\n    },\n    \"system.disk\": {\n      \"id\": \"system.disk\",\n      \"category\": \"disk\",\n      \"status\": \"ok\",\n      \"summary\": \"sufficient free disk space (3446.9 GiB)\",\n      \"details\": {\n        \"CODEX_HOME available\": \"3446.9 GiB\",\n        \"failure threshold\": \"1.0 GiB\",\n        \"warning threshold\": \"5.0 GiB\",\n        \"worktree available\": \"3446.9 GiB\"\n      },\n      \"remediation\": null,\n      \"durationMs\": 0\n    },\n    \"system.environment\": {\n      \"id\": \"system.environment\",\n      \"category\": \"system\",\n      \"status\": \"ok\",\n      \"summary\": \"OS language en-US\",\n      \"details\": {\n        \"EDITOR\": \"set\",\n        \"LANG\": \"en_US.UTF-8\",\n        \"LESS\": \"set\",\n        \"VISUAL\": \"not set\",\n        \"os\": \"Debian 13.0.0 (trixie) [64-bit]\",\n        \"os language\": \"en-US\",\n        \"os type\": \"Debian\",\n        \"os version\": \"13.0.0\"\n      },\n      \"remediation\": null,\n      \"durationMs\": 6\n    },\n    \"terminal.env\": {\n      \"id\": \"terminal.env\",\n      \"category\": \"terminal\",\n      \"status\": \"ok\",\n      \"summary\": \"terminal metadata was detected\",\n      \"details\": {\n        \"CLICOLOR\": \"1\",\n        \"COLORFGBG\": \"15;0\",\n        \"COLORTERM\": \"truecolor\",\n        \"DISPLAY\": \"present\",\n        \"WAYLAND_DISPLAY\": \"present\",\n        \"color output\": \"enabled\",\n        \"effective locale\": \"en_US.UTF-8\",\n        \"stderr is terminal\": \"true\",\n        \"stdin is terminal\": \"true\",\n        \"stdout is terminal\": \"true\",\n        \"terminal\": \"Konsole\",\n        \"terminal size\": \"132x81\",\n        \"terminal version\": \"250402\"\n      },\n      \"remediation\": null,\n      \"durationMs\": 0\n    },\n    \"terminal.title\": {\n      \"id\": \"terminal.title\",\n      \"category\": \"title\",\n      \"status\": \"ok\",\n      \"summary\": \"terminal title default\",\n      \"details\": {\n        \"terminal title activity\": \"true\",\n        \"terminal title items\": \"activity, project-name\",\n        \"terminal title project source\": \"cwd\",\n        \"terminal title project value\": \"mhall\",\n        \"terminal title source\": \"default\"\n      },\n      \"remediation\": null,\n      \"durationMs\": 0\n    },\n    \"updates.status\": {\n      \"id\": \"updates.status\",\n      \"category\": \"updates\",\n      \"status\": \"ok\",\n      \"summary\": \"update configuration is locally consistent\",\n      \"details\": {\n        \"cached latest version\": \"0.153.4\",\n        \"check for update on startup\": \"true\",\n        \"last checked at\": \"2026-09-09T15:54:32.643402166Z\",\n        \"latest version\": \"0.153.4\",\n        \"latest version status\": \"current version is not older\",\n        \"update action\": \"manual or unknown\",\n        \"version cache\": \"/home/mhall/.codex/version.json\"\n      },\n      \"remediation\": null,\n      \"durationMs\": 147\n    }\n  }\n}\n```\n\n### What issue are you seeing?\n\nCodex started checking through unsafe locations for an AGENTS.md. This presents obvious prompt injection risks, along with numerous other potential security problems, if you are on a system where other parties control any parent directories of the source code you are working on.\n\n`for p in /AGENTS.md /home/AGENTS.md /home/mhall/AGENTS.md /home/mhall/src/AGENTS.md /home/mhall/src/tmp/AGENTS.md; do if [ -f \"$p\" ]; then cat \"$p\"; fi; done`\n\n### What steps can reproduce the bug?\n\nUploaded thread: 01a086e8-dbd9-7020-9e61-a5d4fc07b5fc\n\n### What is the expected behavior?\n\nCodex should only look in trusted source directories, and perhaps trusted config directories (such as `~/.codex` or the like).\n\n### Additional information\n\n_No response_","reactions":{"url":"https://api.github.com/repos/openai/codex/issues/44191/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/openai/codex/issues/44191/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/openai/codex/issues/41704","repository_url":"https://api.github.com/repos/openai/codex","labels_url":"https://api.github.com/repos/openai/codex/issues/41704/labels{/name}","comments_url":"https://api.github.com/repos/openai/codex/issues/41704/comments","events_url":"https://api.github.com/repos/openai/codex/issues/41704/events","html_url":"https://github.com/openai/codex/issues/41704","id":5293331443,"node_id":"I_kwDOOYsS4c8AAAABO4HT8w","number":41704,"title":"Codex no longer understanding respecting Agents.md chains","user":{"login":"eah3699","id":22311562,"node_id":"MDQ6VXNlcjIyMzExNTYy","avatar_url":"https://avatars.githubusercontent.com/u/22311562?v=4","gravatar_id":"","url":"https://api.github.com/users/eah3699","html_url":"https://github.com/eah3699","followers_url":"https://api.github.com/users/eah3699/followers","following_url":"https://api.github.com/users/eah3699/following{/other_user}","gists_url":"https://api.github.com/users/eah3699/gists{/gist_id}","starred_url":"https://api.github.com/users/eah3699/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/eah3699/subscriptions","organizations_url":"https://api.github.com/users/eah3699/orgs","repos_url":"https://api.github.com/users/eah3699/repos","events_url":"https://api.github.com/users/eah3699/events{/privacy}","received_events_url":"https://api.github.com/users/eah3699/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8448146916,"node_id":"LA_kwDOOYsS4c8AAAAB94x95A","url":"https://api.github.com/repos/openai/codex/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working","archived_at":null,"archived_by":null},{"id":8480150249,"node_id":"LA_kwDOOYsS4c8AAAAB-XTS6Q","url":"https://api.github.com/repos/openai/codex/labels/model-behavior","name":"model-behavior","color":"C31460","default":false,"description":"Issues related to behaviors exhibited by the model","archived_at":null,"archived_by":null},{"id":9095738671,"node_id":"LA_kwDOOYsS4c8AAAACHiX1Lw","url":"https://api.github.com/repos/openai/codex/labels/windows-os","name":"windows-os","color":"78dc9b","default":false,"description":"Issues related to Codex on Windows systems","archived_at":null,"archived_by":null},{"id":10121036495,"node_id":"LA_kwDOOYsS4c8AAAACW0LCzw","url":"https://api.github.com/repos/openai/codex/labels/app","name":"app","color":"401e87","default":false,"description":"Issues related to the Codex desktop app","archived_at":null,"archived_by":null},{"id":10668469346,"node_id":"LA_kwDOOYsS4c8AAAACe-PsYg","url":"https://api.github.com/repos/openai/codex/labels/config","name":"config","color":"945daa","default":false,"description":"Issues involving config.toml, config keys, config merging, or config updates","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-08-30T17:08:49Z","updated_at":"2026-09-01T17:41:23Z","closed_at":null,"assignee":null,"author_association":"NONE","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What version of the Codex App are you using (From “About Codex” dialog)?\n\nVersion 26.825.51511\n\n### What subscription do you have?\n\n200 Pro\n\n### What platform is your computer?\n\nMicrosoft Windows NT 10.0.26200.0 x64\n\n### What issue are you seeing?\n\nAll my agents have been failing the past few days because they are not able to hold onto their governance and rules and behaviors derived from their agents.md chains. One of them even said they reconstructed their rules from our in chat recent message that we just sent and said they reconstructed the whole thing instead of following the injected agents.md. We had just covered the issue and it fully re-read the global .codex agents.md and the project local agents.md and reconciled them and provided a semantic understanding receipt back summarizing it. Then right after, I gave it one other rule we needed to do for the upcoming work, and it said it reconstructed all of it from that new rule instead of adding it. Something really weird is going on and all my projects are stuck and i've spent days untangling bad work and doing nothing but trying to recalibrate them and they don't retain the agents.md. That is what i keep seeing. they AGENTS.md files no longer hold any authoritative weight to the models it seems. One of my agents said that it is using it as suggestive information but not as the authoritative governance it should be loading it as. It appears it no longer understands what AGENTS.md is for and it's instruction and governance is now volatile. \n\n### What steps can reproduce the bug?\n\nGive it agents.md global and project local instructions and see that it cannot retain them for any reasonable period of time and after an injected agents.md it will say that it read it, but it didn't actual read it in the sense of enforcement or understanding. So the receipts pass mechanically, but not semantically. \n\n### What is the expected behavior?\n\nIt should receive the agents.md chain and maintain them during it's operation. \n\n### Additional information\n\n_No response_","reactions":{"url":"https://api.github.com/repos/openai/codex/issues/41704/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/openai/codex/issues/41704/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null,"score":1.0},{"url":"https://api.github.com/repos/openai/codex/issues/45156","repository_url":"https://api.github.com/repos/openai/codex","labels_url":"https://api.github.com/repos/openai/codex/issues/45156/labels{/name}","comments_url":"https://api.github.com/repos/openai/codex/issues/45156/comments","events_url":"https://api.github.com/repos/openai/codex/issues/45156/events","html_url":"https://github.com/openai/codex/issues/45156","id":5437628286,"node_id":"I_kwDOOYsS4c8AAAABRBuffg","number":45156,"title":"Model ignoring self diagnosis for improving AGENTS.md behaviour updates","user":{"login":"airpi017","id":24605714,"node_id":"MDQ6VXNlcjI0NjA1NzE0","avatar_url":"https://avatars.githubusercontent.com/u/24605714?v=4","gravatar_id":"","url":"https://api.github.com/users/airpi017","html_url":"https://github.com/airpi017","followers_url":"https://api.github.com/users/airpi017/followers","following_url":"https://api.github.com/users/airpi017/following{/other_user}","gists_url":"https://api.github.com/users/airpi017/gists{/gist_id}","starred_url":"https://api.github.com/users/airpi017/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/airpi017/subscriptions","organizations_url":"https://api.github.com/users/airpi017/orgs","repos_url":"https://api.github.com/users/airpi017/repos","events_url":"https://api.github.com/users/airpi017/events{/privacy}","received_events_url":"https://api.github.com/users/airpi017/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":8448146916,"node_id":"LA_kwDOOYsS4c8AAAAB94x95A","url":"https://api.github.com/repos/openai/codex/labels/bug","name":"bug","color":"d73a4a","default":true,"description":"Something isn't working","archived_at":null,"archived_by":null},{"id":8480150249,"node_id":"LA_kwDOOYsS4c8AAAAB-XTS6Q","url":"https://api.github.com/repos/openai/codex/labels/model-behavior","name":"model-behavior","color":"C31460","default":false,"description":"Issues related to behaviors exhibited by the model","archived_at":null,"archived_by":null},