// Shared hk check definitions for reuse across project and image configs.
//
// Exports Mapping<String, Config.Step> values that can be spread into a
// Config.pkl `steps {}` block via the `...` operator.
//
// Usage in an hk.pkl that amends Config.pkl (keep the version in lockstep
// with the amends/import URLs — the hk_version_parity step enforces it):
//   import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
//   import "hk-common.pkl" as common
//   hooks { ["pre-commit"] { steps { ...common.hygiene ...common.safety } } }
//
// #154: builtin linters MUST be assigned from Builtins (`= Builtins.name`), not
// declared as a bare `["name"] {}` block. A bare block constructs a fresh empty
// Step (check=null) that hk silently skips — these steps NEVER ran, locally or
// in CI. See feedback_hk_builtins_need_assignment.

import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"

// #154: shared `exclude` list for the builtin linters that CONSUME `{{files}}`
// — third-party cached docs, generated research artifacts, and gitignored local
// tool caches (not first-party source). Defined once here and referenced by BOTH
// hk.pkl (host) and hk-image.pkl (in-image, used by the devcontainer smoke) so
// they can't drift — a drift is exactly what broke the in-container smoke when
// hk.pkl had the exclude but hk-image.pkl did not.
//
// ⚠️ THIS LIST DOES NOT CONSTRAIN `gitleaks`. Corrected 2026-07-23; the previous
// comment ("`gitleaks dir` ignores .gitignore, so the gitignored caches must be
// listed explicitly") was read as meaning an entry HERE stops gitleaks scanning
// a path. It never did. The builtin runs `gitleaks dir … {{ files }}`, and
// `gitleaks dir` takes only ONE positional path: measured on gitleaks 8.30.1,
// one file scans that file (1.85 KB), while TWO OR MORE files are silently
// discarded and it scans the whole cwd instead (45.87 MB) — gitignored dirs
// included. So gitleaks never reads this list at all, and the other entries look
// effective only because they happen to hold nothing it flags.
//
// gitleaks is scoped by its OWN config, `.gitleaks.toml` (whose header states
// this correctly). The two lists are kept mirrored on purpose: add a path to
// BOTH, and expect only the `.gitleaks.toml` half to affect secret scanning.
// A path that is gitignored AND untracked (e.g. graphify-out/) is invisible to
// the `{{files}}` builtins anyway — its entry here is for symmetry, not effect.
excludePaths: List<String> = List(
  "docs/research/mintlify-cache/**",
  "docs/research/trail/findings/**",
  // Promoted out of `.omc/` on 2026-07-25. Excluded from ALL builtins for the
  // same reason as the two research trees above — and here it is not merely
  // convention but REQUIRED: `.claude/rules/agent-report-persistence.md` says
  // a persisted agent report is kept VERBATIM. Running a typo-fixer or a
  // whitespace normaliser over archived agent output would edit the record the
  // rule exists to preserve. Authored docs under `docs/` are still checked.
  "docs/research/runs/**",
  "docs/research/kb/**",
  // Same reason, third tree (2026-08-08). Specs now carry REQUIREMENTS QUOTED
  // VERBATIM from the user — `docs/specs/devcontainer-gcc162-dual-arch.md`
  // opens with "do NOT paraphrase or tidy the verbatim blocks". `typos` flagged
  // a misspelling inside one such quote: correcting it makes the block no
  // longer verbatim, and once one word is silently fixed nobody can tell which
  // others were. The user's wording is the requirement; our tidy-up of it is
  // not. Authored prose elsewhere under `docs/` is still checked.
  //
  // (Naming the flagged word here would re-trigger the very check this entry
  // exists to satisfy — this file is NOT excluded, and doing so cost one
  // lint round. The word lives in the spec; that is where to look.)
  "docs/specs/**",
  // `.codex/` was a blanket `.codex/**` until #884. It is Codex CLI runtime
  // state, gitignored and therefore invisible to the `{{files}}` builtins
  // either way — until the four HAND-AUTHORED codex-backed agent lanes at
  // `.codex/agents/codex-*.toml` became TRACKED, at which point the blanket
  // entry made every builtin blind to four authored files.
  //
  // Measured 2026-08-31, both arms: with the blanket entry, a planted
  // misspelling in `.codex/agents/codex-advisor.toml` passed `mise run lint` at
  // rc=0 while `typos` on the same file returned rc=2. ⚠️ A `!`-negation does
  // NOT fix that — hk's `exclude` does not honour one: `"!.codex/agents/codex-*.toml"`
  // alongside the blanket entry still returned rc=0 with the same planted word.
  // (Do not spell that word in this file: it is not excluded, so naming it
  // re-triggers the very check these entries exist to restore, and that
  // contaminated the first run of this measurement — the gate went red on the
  // COMMENT while the toml still sailed through.)
  //
  // So the exclusion is enumerated instead. The exported agent mirrors under
  // `.codex/agents/` are deliberately NOT listed: they are gitignored and
  // untracked, hence already invisible, and any pattern broad enough to name
  // them would also swallow the tracked four. `.codex/skills/` is listed ahead
  // of PR #885, which tracks it — it is graphify installer output, excluded for
  // the same reason agnix exempts `.claude/skills/graphify/**`.
  ".codex/config.toml",
  ".codex/hooks.json",
  ".codex/skills/**",
  ".agent/**",
  ".omg/**",
  ".omx/**",
  ".logging/**",
  ".idea/**",
  ".mise/**",
  "graphify-out/**",
  "**/__pycache__/**",
)

// File hygiene builtins — whitespace, line endings, encoding fixes.
hygiene: Mapping<String, Config.Step> = new {
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
}

// Safety builtins — catch accidental secrets, conflicts, large files.
safety: Mapping<String, Config.Step> = new {
  ["detect_private_key"] = Builtins.detect_private_key
  ["check_added_large_files"] = Builtins.check_added_large_files
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  // #160 T12: renamed from the deprecated check_byte_order_marker alias
  // (consolidated upstream in hk 1.30.0; pklr surfaces the deprecation).
  ["byte_order_marker"] = Builtins.byte_order_marker
  // #154: no `no_commit_to_branch` — it errors in CI ("Failed to get current
  // git branch") because GitHub Actions checks out a detached HEAD. It's a
  // local-only guard against committing to main, already enforced by branch
  // protection + .claude/rules/do-not.md, so drop it rather than special-case CI.
}

// Security scanning — secret detection via gitleaks.
//
// `betterleaks` is the SECOND scanner and lives in hk.pkl, not here: this group
// is spread into hk-image.pkl, so a tool referenced here must also exist in the
// image — which means pinning it in the shared mise fragment, which is a base
// image build input and costs a cold rebuild. The scanning that matters happens
// at the commit boundary (host + CI lint), so the project config is the right
// home and the image config is left alone.
security: Mapping<String, Config.Step> = new {
  ["gitleaks"] = (Builtins.gitleaks) {
    batch = true
  }
}

// Typo detection across all file types.
typos: Mapping<String, Config.Step> = new {
  ["typos"] = (Builtins.typos) {
    batch = true
  }
}
