// Shared hk check definitions for reuse across project and image configs.
//
// Exports Mapping<String, Config.Step> values that can be spread into a
// Config.pkl `steps {}` block via the `...` operator.
//
// Usage in an hk.pkl that amends Config.pkl (keep the version in lockstep
// with the amends/import URLs — the hk_version_parity step enforces it):
//   import "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"
//   import "hk-common.pkl" as common
//   hooks { ["pre-commit"] { steps { ...common.hygiene ...common.safety } } }
//
// #154: builtin linters MUST be assigned from Builtins (`= Builtins.name`), not
// declared as a bare `["name"] {}` block. A bare block constructs a fresh empty
// Step (check=null) that hk silently skips — these steps NEVER ran, locally or
// in CI. See feedback_hk_builtins_need_assignment.

import "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v1.49.0/hk@1.49.0#/Config.pkl"

// #154: shared `exclude` list for ALL builtin linters — third-party cached
// docs, generated research artifacts, and gitignored local tool caches (not
// first-party source). Defined once here and referenced by BOTH hk.pkl (host)
// and hk-image.pkl (in-image, used by the devcontainer smoke) so they can't
// drift — a drift is exactly what broke the in-container smoke when hk.pkl had
// the exclude but hk-image.pkl did not. `gitleaks dir` ignores .gitignore, so
// the gitignored caches must be listed explicitly.
excludePaths: List<String> = List(
  "docs/research/mintlify-cache/**",
  "docs/research/trail/findings/**",
  ".codex/**",
  ".omc/**",
  ".omg/**",
  ".omx/**",
  ".logging/**",
  ".idea/**",
  ".mise/**",
  "**/__pycache__/**",
)

// File hygiene builtins — whitespace, line endings, encoding fixes.
hygiene: Mapping<String, Config.Step> = new {
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
}

// Safety builtins — catch accidental secrets, conflicts, large files.
safety: Mapping<String, Config.Step> = new {
  ["detect_private_key"] = Builtins.detect_private_key
  ["check_added_large_files"] = Builtins.check_added_large_files
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  // #160 T12: renamed from the deprecated check_byte_order_marker alias
  // (consolidated upstream in hk 1.30.0; pklr surfaces the deprecation).
  ["byte_order_marker"] = Builtins.byte_order_marker
  // #154: no `no_commit_to_branch` — it errors in CI ("Failed to get current
  // git branch") because GitHub Actions checks out a detached HEAD. It's a
  // local-only guard against committing to main, already enforced by branch
  // protection + .claude/rules/do-not.md, so drop it rather than special-case CI.
}

// Security scanning — secret detection via gitleaks.
security: Mapping<String, Config.Step> = new {
  ["gitleaks"] = (Builtins.gitleaks) {
    batch = true
  }
}

// Typo detection across all file types.
typos: Mapping<String, Config.Step> = new {
  ["typos"] = (Builtins.typos) {
    batch = true
  }
}
