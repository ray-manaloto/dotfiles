{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ray-manaloto/dotfiles/schemas/research-failure-code.schema.json",
  "title": "FailureCode",
  "description": "Closed set of model-visible codes, independent of provider text.",
  "type": "string",
  "enum": [
    "credits-exhausted",
    "prerequisite",
    "quota",
    "credential-missing",
    "auth-failed",
    "unavailable",
    "sandbox-denied",
    "http-error",
    "invalid-json",
    "shape-error",
    "provider-failure",
    "process-failed",
    "timeout",
    "request-failed",
    "credential-invalid",
    "canary-failed",
    "canary-empty",
    "no-canary",
    "not-found",
    "redirected",
    "empty-output",
    "io-error",
    "other"
  ],
  "x-enum-varnames": [
    "CREDITS_EXHAUSTED",
    "PREREQUISITE",
    "QUOTA",
    "CREDENTIAL_MISSING",
    "AUTH_FAILED",
    "UNAVAILABLE",
    "SANDBOX_DENIED",
    "HTTP_ERROR",
    "INVALID_JSON",
    "SHAPE_ERROR",
    "PROVIDER_FAILURE",
    "PROCESS_FAILED",
    "TIMEOUT",
    "REQUEST_FAILED",
    "CREDENTIAL_INVALID",
    "CANARY_FAILED",
    "CANARY_EMPTY",
    "NO_CANARY",
    "NOT_FOUND",
    "REDIRECTED",
    "EMPTY_OUTPUT",
    "IO_ERROR",
    "OTHER"
  ],
  "$comment": "research-fanout projects every non-success row to one of these values and never prints provider diagnostics. Every SkipReason value is also a FailureCode value, so a skipped row projects to its own code (tests/test_research_fanout.py)."
}
