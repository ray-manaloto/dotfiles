{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "repotools",
  "type": "object",
  "additionalProperties": false,
  "description": "Types of the repository checks; mise run //repo:codegen writes src/repotools/models.py from this file.",
  "$defs": {
    "Command": {
      "description": "The repotools subcommands, one per mise task.",
      "type": "string",
      "enum": [
        "pane-fingerprint",
        "pane-pin",
        "pane-approved",
        "pr-fingerprint",
        "pr-approved",
        "pr-create",
        "zero-bash",
        "review-python",
        "review-python-approved",
        "privacy-scan",
        "main-guard",
        "main-guard-install",
        "main-guard-remove",
        "main-guard-armed",
        "te-review"
      ]
    },
    "ZeroBash": {
      "description": "Report tracked shell scripts, shell shebangs and multi-line mise run.",
      "type": "object",
      "properties": {
        "strict": { "type": "boolean", "default": false, "description": "Exit 1 when anything is left" }
      },
      "additionalProperties": false
    },
    "MainGuard": {
      "description": "Refuse a move of refs/heads/main, read from the reference-transaction rows on stdin, unless it is to origin/main.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "MainGuardInstall": {
      "description": "Register the main guard as this repository's reference-transaction hook, after a self-test.",
      "type": "object",
      "properties": {
        "bin": { "type": "string", "description": "The installed repotools executable the hook runs, outside every checkout" }
      },
      "required": ["bin"],
      "additionalProperties": false
    },
    "MainGuardRemove": {
      "description": "Remove the main guard's hook entry from this repository's config and record that the owner switched it off.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "MainGuardArmed": {
      "description": "Print install when hk's post-merge step must install the guard: on main, not switched off, no copy of HEAD's.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Rule": {
      "description": "What a zero-bash finding breaks.",
      "type": "string",
      "enum": ["shell-file", "shell-shebang", "multi-line-run"]
    },
    "Finding": {
      "description": "One zero-bash leftover, printed as a JSON line.",
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Tracked file, relative to the repository root" },
        "rule": { "$ref": "#/$defs/Rule" },
        "detail": { "type": "string", "description": "The file suffix, the shebang, or the TOML key of the run" }
      },
      "required": ["path", "rule", "detail"],
      "additionalProperties": false
    },
    "CommitText": {
      "description": "A commit's message, which the reviewer reads and the approval covers with HEAD and the index.",
      "type": "object",
      "properties": {
        "message": { "type": "string", "description": "The commit message file" }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "PrText": {
      "description": "A pull request's title and body, which the reviewer reads and the approval covers with HEAD.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "pattern": "^[^\\n]+$", "description": "The title, one line" },
        "body_file": { "type": "string", "description": "The file holding the body" }
      },
      "required": ["title", "body_file"],
      "additionalProperties": false
    },
    "PanePin": {
      "description": "Name the Codex session whose approval this checkout accepts.",
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "The session id, as in the rollout file's name"
        }
      },
      "required": ["session"],
      "additionalProperties": false
    },
    "ReviewPython": {
      "description": "Have a read-only Codex reviewer check changes against CODING_STANDARDS.md.",
      "type": "object",
      "properties": {
        "path": { "type": "string", "default": "python", "description": "Directory whose uncommitted changes are reviewed" },
        "commit": { "type": ["string", "null"], "default": null, "description": "Review this commit instead of the uncommitted changes" },
        "out": { "type": ["string", "null"], "default": null, "description": "Report file (default review-python.md in the git dir)" }
      },
      "additionalProperties": false
    },
    "ReviewApproved": {
      "description": "Refuse unless review:python passed on exactly the staged python/ files.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "PrivacyScan": {
      "description": "Refuse this machine's private paths in tracked files, given files, or outgoing commits.",
      "type": "object",
      "properties": {
        "patterns": {
          "type": "string",
          "description": "Private paths, one per line; lines under 8 characters are dropped, and none left exits 2"
        },
        "files": { "type": "string", "default": "", "description": "Files to scan, as mise's shell-quoted usage_file; empty scans every tracked file" },
        "outgoing": { "type": "boolean", "default": false, "description": "Scan every commit not yet on a remote, branches and tags" }
      },
      "required": ["patterns"],
      "additionalProperties": false
    },
    "Options": {
      "description": "What a repotools command parses from its arguments.",
      "anyOf": [
        { "$ref": "#/$defs/CommitText" },
        { "$ref": "#/$defs/PrText" },
        { "$ref": "#/$defs/PanePin" },
        { "$ref": "#/$defs/ZeroBash" },
        { "$ref": "#/$defs/ReviewPython" },
        { "$ref": "#/$defs/ReviewApproved" },
        { "$ref": "#/$defs/PrivacyScan" },
        { "$ref": "#/$defs/MainGuard" },
        { "$ref": "#/$defs/MainGuardInstall" },
        { "$ref": "#/$defs/MainGuardRemove" },
        { "$ref": "#/$defs/MainGuardArmed" },
        { "$ref": "#/$defs/TeReviewCollect" },
        { "$ref": "#/$defs/TeReviewReport" }
      ]
    },
    "Fingerprint": {
      "description": "What an approval must name, printed as a JSON line.",
      "type": "object",
      "properties": {
        "fingerprint": { "type": "string", "description": "Hash of what is approved: HEAD with the index and message, or with a pull request's text" }
      },
      "required": ["fingerprint"],
      "additionalProperties": false
    },
    "RolloutLine": {
      "description": "One line of a Codex session rollout; only the fields the check reads.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "session_meta, turn_context, response_item or event_msg" },
        "payload": { "type": "object", "description": "Depends on type" }
      },
      "required": ["type", "payload"]
    },
    "SessionMeta": {
      "description": "A rollout's session_meta payload.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The session id" },
        "cwd": { "type": "string", "description": "The folder the session started in" },
        "forked_from_id": { "type": ["string", "null"], "description": "Set on a forked session" }
      },
      "required": ["id", "cwd"]
    },
    "SandboxPolicy": {
      "description": "A turn's legacy sandbox field.",
      "type": "object",
      "properties": { "type": { "type": "string", "description": "read-only when nothing may be written" } },
      "required": ["type"]
    },
    "FileAccess": {
      "description": "One filesystem permission entry.",
      "type": "object",
      "properties": { "access": { "type": "string", "description": "read when the entry only reads" } },
      "required": ["access"]
    },
    "FileSystem": {
      "description": "A turn's effective filesystem permissions.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "restricted when entries list everything allowed" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/FileAccess" }, "description": "What is allowed" }
      },
      "required": ["type", "entries"]
    },
    "PermissionProfile": {
      "description": "A turn's effective permissions; only a managed profile lists its filesystem access.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "managed, disabled (no sandbox) or external" },
        "file_system": { "$ref": "#/$defs/FileSystem" }
      },
      "required": ["type"]
    },
    "TurnContext": {
      "description": "A rollout's turn_context payload.",
      "type": "object",
      "properties": {
        "turn_id": { "type": "string", "description": "The turn these settings apply to" },
        "cwd": { "type": "string", "description": "The turn's working folder" },
        "approval_policy": { "type": "string", "description": "never when no command can ask for more" },
        "sandbox_policy": { "$ref": "#/$defs/SandboxPolicy" },
        "permission_profile": { "$ref": "#/$defs/PermissionProfile" }
      },
      "required": ["turn_id", "cwd", "approval_policy", "sandbox_policy", "permission_profile"]
    },
    "OutputText": {
      "description": "One content part of a message; an image part has no text.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "output_text for what the assistant wrote" },
        "text": { "type": ["string", "null"], "description": "The words" }
      },
      "required": ["type"]
    },
    "Message": {
      "description": "A rollout's response_item message payload.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "description": "assistant, user or developer" },
        "phase": { "type": ["string", "null"], "description": "final_answer on a turn's answer" },
        "content": { "type": "array", "items": { "$ref": "#/$defs/OutputText" }, "description": "The parts" }
      },
      "required": ["role", "content"]
    },
    "TaskEvent": {
      "description": "A rollout's task_started, task_complete or turn_aborted payload.",
      "type": "object",
      "properties": {
        "turn_id": { "type": "string", "description": "The turn" },
        "last_agent_message": { "type": ["string", "null"], "description": "The answer, on task_complete" }
      },
      "required": ["turn_id"]
    },
    "TeReviewCommand": {
      "description": "The te-review subcommands, the word after te-review.",
      "type": "string",
      "enum": ["collect", "report"]
    },
    "TeReviewCollect": {
      "description": "Freeze the TokenEconomizer Claude ledger rows of a window into a new, create-only evidence collection.",
      "type": "object",
      "properties": {
        "since": { "type": "string", "format": "date", "description": "First calendar day of the window, inclusive" },
        "until": { "type": "string", "format": "date", "description": "Last calendar day of the window, inclusive" },
        "tz": { "type": "string", "description": "IANA time zone the calendar days are read in, such as America/Chicago" },
        "out": { "type": "string", "description": "The collection directory, which must not exist" },
        "te_root": {
          "type": ["string", "null"],
          "default": null,
          "description": "TokenEconomizer state root (default $TOKENECONOMIZER_HOME, else ~/.tokeneconomizer)"
        }
      },
      "required": ["since", "until", "tz", "out"],
      "additionalProperties": false
    },
    "ErrorCode": {
      "description": "Why a te-review command stopped; collect writes nothing when it does.",
      "type": "string",
      "enum": [
        "OUT_EXISTS",
        "BAD_WINDOW",
        "BAD_TIMEZONE",
        "NO_LEDGER",
        "UNREADABLE",
        "MALFORMED_LINE",
        "TRUNCATED_LINE",
        "UNKNOWN_SCHEMA",
        "SOURCE_CHANGED",
        "RELATIVE_PATH",
        "BAD_MODE",
        "NOT_COMPLETE",
        "BAD_BUNDLE",
        "HASH_MISMATCH",
        "BAD_ARGUMENTS"
      ]
    },
    "CodedFailure": {
      "description": "Why a te-review command stopped, printed as a JSON line on stderr.",
      "type": "object",
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "error": { "type": "string", "description": "The message" }
      },
      "required": ["code", "error"],
      "additionalProperties": false
    },
    "SessionRow": {
      "description": "A TokenEconomizer 0.1.0 ledger session row, as plugin/fold.py fold_locked writes it; other keys are unknown.",
      "type": "object",
      "properties": {
        "kind": { "const": "session", "description": "The record kind" },
        "session_id": { "type": "string", "description": "The Claude session id" },
        "host": { "const": "claude", "description": "The agent host; this adapter reads Claude only" },
        "repo": { "type": "string", "description": "The repository label" },
        "folded_at": { "type": "number", "description": "When the session was folded, Unix seconds" },
        "started": { "type": ["number", "null"], "description": "Session start, Unix seconds" },
        "ended": { "type": ["number", "null"], "description": "Session end, Unix seconds; the window selects on it" },
        "shadow": { "type": "boolean", "description": "Folded in shadow mode" },
        "imported": { "type": "boolean", "description": "Folded from the agent's history, from before the plugin" },
        "prompts": { "type": ["integer", "null"], "description": "Prompts in the transcript" },
        "error": { "type": "string", "description": "Why the transcript could not be read" },
        "injection": { "type": ["object", "null"], "description": "The micro-skills fold result" },
        "untool": { "type": ["object", "null"], "description": "The tool-pruning fold result" },
        "model": { "type": ["string", "null"], "description": "The billed model id" },
        "requests": { "type": ["integer", "null"], "description": "Model requests" },
        "input_tokens": { "type": ["integer", "null"], "description": "Fresh input tokens" },
        "cache_read_input_tokens": { "type": ["integer", "null"], "description": "Cached input tokens read" },
        "cache_creation_input_tokens": { "type": ["integer", "null"], "description": "Cached input tokens written" },
        "output_tokens": { "type": ["integer", "null"], "description": "Output tokens" },
        "effective_tokens": { "type": ["number", "null"], "description": "Cache-aware effective tokens" },
        "priced_by": { "type": ["string", "null"], "description": "model, fallback or no_usage" },
        "turns": { "type": "integer", "description": "Turns the plugin recorded" },
        "nudges": { "type": "integer", "description": "Redirects delivered" },
        "aborts": { "type": "integer", "description": "Still-stuck notices" },
        "injected_chars": { "type": "integer", "description": "Characters injected at session start" },
        "untool_applied": { "type": "array", "description": "Deny rules the session ran under" },
        "overhead": { "type": "object", "description": "Mechanism overhead tokens, by ledger.py OVERHEAD_KEYS" }
      },
      "required": [
        "kind",
        "session_id",
        "host",
        "repo",
        "folded_at",
        "started",
        "ended",
        "shadow",
        "prompts",
        "turns",
        "nudges",
        "aborts",
        "injected_chars",
        "untool_applied",
        "overhead"
      ],
      "additionalProperties": false
    },
    "OverheadRow": {
      "description": "A TokenEconomizer 0.1.0 ledger overhead row, as plugin/judge.py run_job writes it; other keys are an unknown schema.",
      "type": "object",
      "properties": {
        "kind": { "const": "overhead", "description": "The record kind" },
        "session_id": { "type": "string", "description": "The Claude session charged" },
        "host": { "const": "claude", "description": "The agent host; this adapter reads Claude only" },
        "job": { "type": ["string", "null"], "description": "The judge job; a charge without one is ambiguous" },
        "at": { "type": "number", "description": "When it was charged, Unix seconds" },
        "overhead": { "type": "object", "description": "Mechanism overhead tokens, by ledger.py OVERHEAD_KEYS" }
      },
      "required": ["kind", "session_id", "host", "at", "overhead"],
      "additionalProperties": false
    },
    "RowKind": {
      "description": "A ledger record kind.",
      "type": "string",
      "enum": ["session", "overhead"]
    },
    "RowClass": {
      "description": "What the collection made of a distinct ledger row.",
      "type": "string",
      "enum": [
        "in_window",
        "outside_window",
        "missing_end",
        "matched",
        "not_selected",
        "unmatched",
        "conflict",
        "ambiguous"
      ]
    },
    "SourceLine": {
      "description": "Where a row was read.",
      "type": "object",
      "properties": {
        "source": { "type": "string", "description": "The ledger file, relative to the state root" },
        "line": { "type": "integer", "description": "The 1-based line number" }
      },
      "required": ["source", "line"],
      "additionalProperties": false
    },
    "LedgerRead": {
      "description": "One ledger row as read: its store, its place, the validated record and the row itself.",
      "type": "object",
      "properties": {
        "store": { "type": "string", "description": "The repository store, repos/<label> under the state root" },
        "place": { "$ref": "#/$defs/SourceLine" },
        "record": { "anyOf": [{ "$ref": "#/$defs/SessionRow" }, { "$ref": "#/$defs/OverheadRow" }] },
        "row": { "type": "object", "description": "The row as read" }
      },
      "required": ["store", "place", "record", "row"],
      "additionalProperties": false
    },
    "EvidenceRow": {
      "description": "One distinct ledger row and its class; identical repeats are one row with their count.",
      "type": "object",
      "properties": {
        "ref": { "type": "string", "description": "Opaque reference, stable within the collection" },
        "kind": { "$ref": "#/$defs/RowKind" },
        "row_class": { "$ref": "#/$defs/RowClass" },
        "store": { "type": "string", "description": "The repository store, repos/<label> under the state root" },
        "host": { "type": "string", "description": "The agent host" },
        "session_id": { "type": "string", "description": "The session" },
        "job": { "type": ["string", "null"], "description": "The charge's judge job; null for a session or a charge without one" },
        "count": { "type": "integer", "description": "How many identical copies were read" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/SourceLine" }, "description": "Every copy's place" },
        "row": { "type": "object", "description": "The row as read" }
      },
      "required": ["ref", "kind", "row_class", "store", "host", "session_id", "job", "count", "lines", "row"],
      "additionalProperties": false
    },
    "Evidence": {
      "description": "evidence.json: every distinct row read, in source order.",
      "type": "object",
      "properties": {
        "rows": { "type": "array", "items": { "$ref": "#/$defs/EvidenceRow" }, "description": "The rows" }
      },
      "required": ["rows"],
      "additionalProperties": false
    },
    "Window": {
      "description": "Inclusive calendar days in a time zone, read as the half-open instants [start, end).",
      "type": "object",
      "properties": {
        "since": { "type": "string", "format": "date", "description": "First day" },
        "until": { "type": "string", "format": "date", "description": "Last day" },
        "tz": { "type": "string", "description": "IANA time zone" },
        "start": { "type": "string", "format": "date-time", "description": "since at 00:00 in tz, included" },
        "end": { "type": "string", "format": "date-time", "description": "The day after until at 00:00 in tz, excluded" }
      },
      "required": ["since", "until", "tz", "start", "end"],
      "additionalProperties": false
    },
    "Label": {
      "description": "INTERIM when collected before the window's end, else FINAL.",
      "type": "string",
      "enum": ["INTERIM", "FINAL"]
    },
    "SourceFile": {
      "description": "One consumed ledger file, as hashed before and after the read.",
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Relative to the state root" },
        "bytes": { "type": "integer", "description": "Size" },
        "sha256": { "type": "string", "description": "Hash of the bytes read" },
        "lines": { "type": "integer", "description": "Line count" }
      },
      "required": ["path", "bytes", "sha256", "lines"],
      "additionalProperties": false
    },
    "Mirror": {
      "description": "A TokenEconomizer source file whose row shapes the adapter mirrors.",
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Relative to the plugin root" },
        "sha256": { "type": "string", "description": "Hash of the file at the mirrored version" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "Versions": {
      "description": "What read the ledgers.",
      "type": "object",
      "properties": {
        "adapter": { "type": "string", "description": "The ledger adapter, named by the TokenEconomizer version it mirrors" },
        "schema": { "type": "integer", "description": "The evidence and collection schema version" },
        "mirrors": { "type": "array", "items": { "$ref": "#/$defs/Mirror" }, "description": "The mirrored source files" }
      },
      "required": ["adapter", "schema", "mirrors"],
      "additionalProperties": false
    },
    "Collection": {
      "description": "collection.json: when and from what evidence.json was built.",
      "type": "object",
      "properties": {
        "collection_id": { "type": "string", "description": "sha256 over the window, versions, every source's bytes and evidence.json" },
        "collected_at": { "type": "string", "format": "date-time", "description": "When, in the window's time zone" },
        "label": { "$ref": "#/$defs/Label" },
        "window": { "$ref": "#/$defs/Window" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/SourceFile" }, "description": "The consumed ledgers" },
        "versions": { "$ref": "#/$defs/Versions" }
      },
      "required": ["collection_id", "collected_at", "label", "window", "sources", "versions"],
      "additionalProperties": false
    },
    "TeReviewReport": {
      "description": "Print the overhead accounting of a frozen te-review collection.",
      "type": "object",
      "properties": {
        "evidence": {"type": "string", "description": "The collection directory, an absolute path"},
        "public": {"type": "boolean", "default": false, "description": "Print only the public report (the default)"},
        "private": {"type": "boolean", "default": false, "description": "Print the private report, with every row and key name"}
      },
      "required": ["evidence"],
      "additionalProperties": false
    },
    "PublicFailure": {
      "description": "Why te-review report stopped, in public mode: the code only.",
      "type": "object",
      "properties": {
        "code": {"$ref": "#/$defs/ErrorCode"}
      },
      "required": ["code"],
      "additionalProperties": false
    },
    "OverheadKey": {
      "description": "The overhead token fields TokenEconomizer 0.1.0's ledger.py OVERHEAD_KEYS names; each counts toward the total.",
      "type": "string",
      "enum": ["optimizer_tokens", "untool_classify_tokens", "untool_judge_tokens", "codex_untool_adapt_tokens", "spiral_judge_tokens", "spiral_nudge_writer_tokens"]
    },
    "SessionClass": {
      "description": "What a session was, from receipts; without one it is unknown.",
      "type": "string",
      "enum": ["real_work", "synthetic", "unknown"]
    },
    "Exclusion": {
      "description": "Why a row is outside the headline cohort; a row is counted under the first of its reasons in this order.",
      "type": "string",
      "enum": ["NOT_SELECTED", "MISSING_END", "CONFLICT", "AMBIGUOUS", "UNMATCHED", "IMPORTED", "MISSING_USAGE", "ERROR", "FALLBACK_PRICING", "UNKNOWN_PRICING_STATUS", "BAD_AMOUNT", "SYNTHETIC", "UNCLASSIFIED", "SESSION_EXCLUDED", "CHARGE_EXCLUDED"]
    },
    "ShareStatus": {
      "description": "KNOWN, or UNKNOWN for a zero or non-finite denominator.",
      "type": "string",
      "enum": ["KNOWN", "UNKNOWN"]
    },
    "Verdict": {
      "description": "Whether the share is above the threshold.",
      "type": "string",
      "enum": ["YES", "NO", "UNKNOWN"]
    },
    "Cadence": {
      "description": "The fold cadence; UNKNOWN unless a cadence receipt proves the fold process's effective policy.",
      "type": "string",
      "enum": ["1", "3", "UNKNOWN"]
    },
    "Scope": {
      "description": "What the numbers are: charges the ledger recorded, not a billing audit.",
      "const": "recorded charges"
    },
    "OverheadComponents": {
      "description": "Overhead tokens by recognized key; a sum is null when it is not finite.",
      "type": "object",
      "properties": {
        "optimizer_tokens": {"type": ["number", "null"], "description": "Sum of optimizer_tokens"},
        "untool_classify_tokens": {"type": ["number", "null"], "description": "Sum of untool_classify_tokens"},
        "untool_judge_tokens": {"type": ["number", "null"], "description": "Sum of untool_judge_tokens"},
        "codex_untool_adapt_tokens": {"type": ["number", "null"], "description": "Sum of codex_untool_adapt_tokens"},
        "spiral_judge_tokens": {"type": ["number", "null"], "description": "Sum of spiral_judge_tokens"},
        "spiral_nudge_writer_tokens": {"type": ["number", "null"], "description": "Sum of spiral_nudge_writer_tokens"}
      },
      "required": ["optimizer_tokens", "untool_classify_tokens", "untool_judge_tokens", "codex_untool_adapt_tokens", "spiral_judge_tokens", "spiral_nudge_writer_tokens"],
      "additionalProperties": false
    },
    "Share": {
      "description": "overhead / (effective + overhead) over a set of rows, as TE's plugin/accounting.py summarize has it.",
      "type": "object",
      "properties": {
        "sessions": {"type": "integer", "description": "Session rows counted"},
        "charges": {"type": "integer", "description": "Overhead charge rows counted"},
        "effective_tokens": {"type": ["number", "null"], "description": "Sum of the sessions' effective tokens; null when not finite"},
        "overhead_tokens": {"type": ["number", "null"], "description": "Sum of the recognized overhead keys, and in all_keys of every key; null when not finite"},
        "components": {"$ref": "#/$defs/OverheadComponents"},
        "unknown_overhead_keys": {"type": "integer", "description": "How many distinct unrecognized overhead keys were counted"},
        "share": {"type": ["number", "null"], "description": "The share; null when UNKNOWN"},
        "status": {"$ref": "#/$defs/ShareStatus"},
        "above_5_percent": {"$ref": "#/$defs/Verdict"}
      },
      "required": ["sessions", "charges", "effective_tokens", "overhead_tokens", "components", "unknown_overhead_keys", "share", "status", "above_5_percent"],
      "additionalProperties": false
    },
    "ExcludedCount": {
      "description": "The rows whose first exclusion reason is this one, and their recorded spend.",
      "type": "object",
      "properties": {
        "reason": {"$ref": "#/$defs/Exclusion"},
        "rows": {"type": "integer", "description": "Rows"},
        "effective_tokens": {"type": ["number", "null"], "description": "Sum of their finite recorded effective tokens; null when the sum is not finite"},
        "overhead_tokens": {"type": ["number", "null"], "description": "Their finite recorded tokens of the recognized keys, in all_keys of every key; null when not finite"},
        "invalid_amounts": {"type": "integer", "description": "Amounts left out of the sums, not a finite number; of the recognized keys, and in all_keys of every key"}
      },
      "required": ["reason", "rows", "effective_tokens", "overhead_tokens", "invalid_amounts"],
      "additionalProperties": false
    },
    "ClassCount": {
      "description": "Selected sessions of one class.",
      "type": "object",
      "properties": {
        "session_class": {"$ref": "#/$defs/SessionClass"},
        "sessions": {"type": "integer", "description": "Sessions"}
      },
      "required": ["session_class", "sessions"],
      "additionalProperties": false
    },
    "EraCandidate": {
      "description": "A policy-era candidate: selected sessions folded on one calendar day; a timestamp group, not a proven cadence.",
      "type": "object",
      "properties": {
        "folded_on": {"type": ["string", "null"], "format": "date", "description": "The fold's calendar day in the window's time zone; null for a fold time no calendar holds"},
        "sessions": {"type": "integer", "description": "Sessions"}
      },
      "required": ["folded_on", "sessions"],
      "additionalProperties": false
    },
    "PublicReport": {
      "description": "te-review report --public: aggregates, fixed codes and dates only.",
      "type": "object",
      "properties": {
        "scope": {"$ref": "#/$defs/Scope"},
        "label": {"$ref": "#/$defs/Label"},
        "since": {"type": "string", "format": "date", "description": "First day of the window"},
        "until": {"type": "string", "format": "date", "description": "Last day of the window"},
        "headline": {"$ref": "#/$defs/Share"},
        "selected": {"$ref": "#/$defs/Share", "description": "Every selected non-imported session and its matched charges, whatever its class; not the headline"},
        "excluded": {"type": "array", "items": {"$ref": "#/$defs/ExcludedCount"}, "description": "Every exclusion reason, in precedence order"},
        "session_classes": {"type": "array", "items": {"$ref": "#/$defs/ClassCount"}, "description": "Selected sessions by class"},
        "cadence": {"$ref": "#/$defs/Cadence"},
        "policy_era_candidates": {"type": "array", "items": {"$ref": "#/$defs/EraCandidate"}, "description": "Timestamp groups only"},
        "unknown_keys": {"type": "string", "pattern": "^unknown keys: [0-9]+ \\(excluded from public totals\\)$", "description": "How many distinct unrecognized overhead keys the collection holds; the totals leave their amounts out"}
      },
      "required": ["scope", "label", "since", "until", "headline", "selected", "excluded", "session_classes", "cadence", "policy_era_candidates", "unknown_keys"],
      "additionalProperties": false
    },
    "AllKeys": {
      "description": "The report's figures with every overhead key counted, unrecognized ones included; private only.",
      "type": "object",
      "properties": {
        "headline": {"$ref": "#/$defs/Share"},
        "selected": {"$ref": "#/$defs/Share"},
        "excluded": {"type": "array", "items": {"$ref": "#/$defs/ExcludedCount"}, "description": "Every exclusion reason, in precedence order"}
      },
      "required": ["headline", "selected", "excluded"],
      "additionalProperties": false
    },
    "RowReport": {
      "description": "One evidence row in the private report, with all its exclusion reasons.",
      "type": "object",
      "properties": {
        "ref": {"type": "string", "description": "The evidence row's ref"},
        "kind": {"$ref": "#/$defs/RowKind"},
        "store": {"type": "string", "description": "The repository store"},
        "session_id": {"type": "string", "description": "The session"},
        "job": {"type": ["string", "null"], "description": "The charge's judge job"},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/Exclusion"}, "description": "Every reason, in precedence order; empty in the headline cohort"}
      },
      "required": ["ref", "kind", "store", "session_id", "job", "reasons"],
      "additionalProperties": false
    },
    "PrivateReport": {
      "description": "te-review report --private: the public report as it is, plus the figures with every key, every row and unknown key.",
      "type": "object",
      "properties": {
        "collection_id": {"type": "string", "description": "The collection read"},
        "tz": {"type": "string", "description": "The window's time zone"},
        "report": {"$ref": "#/$defs/PublicReport"},
        "all_keys": {"$ref": "#/$defs/AllKeys"},
        "unknown_overhead_keys": {"type": "object", "additionalProperties": {"type": ["number", "null"]}, "description": "Each unrecognized overhead key and its sum over the selected rows; null when not finite"},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/RowReport"}, "description": "Every evidence row"}
      },
      "required": ["collection_id", "tz", "report", "all_keys", "unknown_overhead_keys", "rows"],
      "additionalProperties": false
    },
    "Failure": {
      "description": "Why a command stopped, printed as a JSON line on stderr.",
      "type": "object",
      "properties": {
        "error": { "type": "string", "description": "The message" }
      },
      "required": ["error"],
      "additionalProperties": false
    }
  },
  "properties": {
    "failure": { "$ref": "#/$defs/Failure" },
    "command": { "$ref": "#/$defs/Command" },
    "commit_text": { "$ref": "#/$defs/CommitText" },
    "pr_text": { "$ref": "#/$defs/PrText" },
    "pane_pin": { "$ref": "#/$defs/PanePin" },
    "zero_bash": { "$ref": "#/$defs/ZeroBash" },
    "review_python": { "$ref": "#/$defs/ReviewPython" },
    "review_approved": { "$ref": "#/$defs/ReviewApproved" },
    "privacy_scan": { "$ref": "#/$defs/PrivacyScan" },
    "main_guard": { "$ref": "#/$defs/MainGuard" },
    "main_guard_install": { "$ref": "#/$defs/MainGuardInstall" },
    "main_guard_remove": { "$ref": "#/$defs/MainGuardRemove" },
    "main_guard_armed": { "$ref": "#/$defs/MainGuardArmed" },
    "options": { "$ref": "#/$defs/Options" },
    "finding": { "$ref": "#/$defs/Finding" },
    "fingerprint": { "$ref": "#/$defs/Fingerprint" },
    "rollout_line": { "$ref": "#/$defs/RolloutLine" },
    "session_meta": { "$ref": "#/$defs/SessionMeta" },
    "turn_context": { "$ref": "#/$defs/TurnContext" },
    "message": { "$ref": "#/$defs/Message" },
    "task_event": { "$ref": "#/$defs/TaskEvent" },
    "te_review_command": { "$ref": "#/$defs/TeReviewCommand" },
    "te_review_collect": { "$ref": "#/$defs/TeReviewCollect" },
    "coded_failure": { "$ref": "#/$defs/CodedFailure" },
    "session_row": { "$ref": "#/$defs/SessionRow" },
    "overhead_row": { "$ref": "#/$defs/OverheadRow" },
    "evidence": { "$ref": "#/$defs/Evidence" },
    "collection": { "$ref": "#/$defs/Collection" },
    "ledger_read": { "$ref": "#/$defs/LedgerRead" },
    "te_review_report": { "$ref": "#/$defs/TeReviewReport" },
    "public_failure": { "$ref": "#/$defs/PublicFailure" },
    "public_report": { "$ref": "#/$defs/PublicReport" },
    "private_report": { "$ref": "#/$defs/PrivateReport" }
  }
}
