+static const mach_header *GetDyldImageHeaderViaTaskInfo() {
+  task_dyld_info_data_t info = {};
+  mach_msg_type_number_t count = TASK_DYLD_INFO_COUNT;
+  CHECK_EQ(task_info(mach_task_self(), TASK_DYLD_INFO,
+                     reinterpret_cast<task_info_t>(&info), &count),
+           KERN_SUCCESS);
+  CHECK_EQ(count, TASK_DYLD_INFO_COUNT);
+  CHECK_EQ(info.all_image_info_format, TASK_DYLD_ALL_IMAGE_INFO_64);
+  CHECK(info.all_image_info_addr);
+  CHECK_GE(info.all_image_info_size,
+           offsetof(dyld_all_image_infos, dyldImageLoadAddress) +
+               sizeof(const mach_header *));
+  const auto *images = reinterpret_cast<const dyld_all_image_infos *>(
+      info.all_image_info_addr);
+  CHECK_GE(images->version, 2);
+  const mach_header *header = images->dyldImageLoadAddress;
+  CHECK(header);
+  CHECK_EQ(header->magic, MH_MAGIC_64);
+  CHECK_EQ(header->filetype, MH_DYLINKER);
+  return header;
+}
