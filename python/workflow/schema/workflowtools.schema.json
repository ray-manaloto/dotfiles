{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflowtools",
  "type": "object",
  "additionalProperties": false,
  "description": "Types of the workflow checks; mise run //workflow:codegen writes src/workflowtools/models.py from this file.",
  "properties": {
    "command": {
      "$ref": "#/$defs/Command"
    },
    "frontmatter": {
      "$ref": "#/$defs/Frontmatter"
    },
    "skill_table": {
      "$ref": "#/$defs/SkillTable"
    },
    "listing": {
      "$ref": "#/$defs/Listing"
    },
    "tickets": {
      "$ref": "#/$defs/Tickets"
    },
    "settings_local": {
      "$ref": "#/$defs/SettingsLocal"
    },
    "options": {
      "$ref": "#/$defs/Options"
    },
    "check": {
      "$ref": "#/$defs/Check"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "skipped": {
      "$ref": "#/$defs/Skipped"
    },
    "listed": {
      "$ref": "#/$defs/Listed"
    },
    "failure": {
      "$ref": "#/$defs/Failure"
    },
    "skill_frontmatter": {
      "$ref": "#/$defs/SkillFrontmatter"
    },
    "okf_frontmatter": {
      "$ref": "#/$defs/OkfFrontmatter"
    },
    "plugin_manifest": {
      "$ref": "#/$defs/PluginManifest"
    },
    "plugin_record": {
      "$ref": "#/$defs/PluginRecord"
    },
    "installed_plugins": {
      "$ref": "#/$defs/InstalledPlugins"
    },
    "ticket": {
      "$ref": "#/$defs/Ticket"
    }
  },
  "$defs": {
    "Command": {
      "description": "The workflowtools subcommands, one per mise task.",
      "type": "string",
      "enum": [
        "frontmatter",
        "skill-table",
        "tickets",
        "settings-local"
      ]
    },
    "Frontmatter": {
      "description": "Check every SKILL.md and okf concept file's frontmatter, and that every YAML file parses, as the index has them.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "SkillTable": {
      "description": "Check the workflow docs' skills.md against the user-scope mattpocock-skills plugin install.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Listing": {
      "description": "Which tickets to print after a clean check.",
      "type": "string",
      "enum": [
        "frontier",
        "open"
      ]
    },
    "Tickets": {
      "description": "Check every ticket under .scratch against the status table in docs/agents/issue-tracker.md.",
      "type": "object",
      "properties": {
        "listing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Listing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "After a clean check, print the tickets ready to start (frontier) or not yet finished (open)"
        },
        "feature": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only this feature folder under .scratch"
        }
      },
      "additionalProperties": false
    },
    "SettingsLocal": {
      "description": "Refuse a .claude/settings.local.json in this worktree, in the main checkout, or in the index.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Options": {
      "description": "What a workflowtools command parses from its arguments.",
      "anyOf": [
        {
          "$ref": "#/$defs/Frontmatter"
        },
        {
          "$ref": "#/$defs/SkillTable"
        },
        {
          "$ref": "#/$defs/Tickets"
        },
        {
          "$ref": "#/$defs/SettingsLocal"
        }
      ]
    },
    "Check": {
      "description": "The check a finding comes from.",
      "type": "string",
      "enum": [
        "frontmatter",
        "skill-table",
        "tickets",
        "settings-local"
      ]
    },
    "Finding": {
      "description": "One problem, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File, relative to the repository root; settings-local names an absolute path in another checkout"
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "detail": {
          "type": "string",
          "description": "What is wrong"
        }
      },
      "required": [
        "path",
        "check",
        "detail"
      ],
      "additionalProperties": false
    },
    "Skipped": {
      "description": "A check with nothing to compare, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "reason": {
          "type": "string",
          "description": "Why it compared nothing"
        }
      },
      "required": [
        "check",
        "reason"
      ],
      "additionalProperties": false
    },
    "Listed": {
      "description": "One ticket a listing selected, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The ticket file, relative to the repository root"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "Failure": {
      "description": "Why a command stopped, printed as a JSON line on stderr.",
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "The message"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "SkillFrontmatter": {
      "description": "The SKILL.md frontmatter keys every harness needs; others pass.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The skill name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "When the skill applies",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": true
    },
    "OkfFrontmatter": {
      "description": "An okf concept file's frontmatter: a type; others pass.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "The concept type",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "PluginManifest": {
      "description": "The part of a Claude Code plugin's .claude-plugin/plugin.json read here.",
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skill folders, relative to the plugin root"
        }
      },
      "required": [
        "skills"
      ],
      "additionalProperties": true
    },
    "PluginRecord": {
      "description": "One install of a plugin in ~/.claude/plugins/installed_plugins.json.",
      "type": "object",
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "user, project or local"
        },
        "projectPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The project a project-scoped install belongs to"
        },
        "installPath": {
          "type": "string",
          "description": "Where the plugin's files are"
        },
        "gitCommitSha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plugin commit installed"
        }
      },
      "required": [
        "installPath"
      ],
      "additionalProperties": true
    },
    "InstalledPlugins": {
      "description": "~/.claude/plugins/installed_plugins.json, the part read here.",
      "type": "object",
      "properties": {
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PluginRecord"
            }
          },
          "description": "Installs by plugin id"
        }
      },
      "required": [
        "plugins"
      ],
      "additionalProperties": true
    },
    "Ticket": {
      "description": "One ticket file under .scratch/<feature>/issues/, as read.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The file, relative to the repository root"
        },
        "feature": {
          "type": "string",
          "description": "Its feature folder"
        },
        "number": {
          "type": "string",
          "description": "Its two-digit number"
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every Status line's value"
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every Blocked by line's value"
        }
      },
      "required": [
        "path",
        "feature",
        "number",
        "statuses",
        "blocked_by"
      ],
      "additionalProperties": false
    }
  }
}
