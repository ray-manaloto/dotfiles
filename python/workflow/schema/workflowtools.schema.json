{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflowtools",
  "type": "object",
  "additionalProperties": false,
  "description": "Types of the workflow checks; mise run //workflow:codegen writes src/workflowtools/models.py from this file.",
  "properties": {
    "command": {
      "$ref": "#/$defs/Command"
    },
    "frontmatter": {
      "$ref": "#/$defs/Frontmatter"
    },
    "skill_table": {
      "$ref": "#/$defs/SkillTable"
    },
    "listing": {
      "$ref": "#/$defs/Listing"
    },
    "tickets": {
      "$ref": "#/$defs/Tickets"
    },
    "settings_local": {
      "$ref": "#/$defs/SettingsLocal"
    },
    "options": {
      "$ref": "#/$defs/Options"
    },
    "check": {
      "$ref": "#/$defs/Check"
    },
    "finding": {
      "$ref": "#/$defs/Finding"
    },
    "skipped": {
      "$ref": "#/$defs/Skipped"
    },
    "failure": {
      "$ref": "#/$defs/Failure"
    },
    "skill_frontmatter": {
      "$ref": "#/$defs/SkillFrontmatter"
    },
    "okf_frontmatter": {
      "$ref": "#/$defs/OkfFrontmatter"
    },
    "plugin_manifest": {
      "$ref": "#/$defs/PluginManifest"
    },
    "plugin_record": {
      "$ref": "#/$defs/PluginRecord"
    },
    "installed_plugins": {
      "$ref": "#/$defs/InstalledPlugins"
    },
    "issue_state": {
      "$ref": "#/$defs/IssueState"
    },
    "github_issue": {
      "$ref": "#/$defs/GitHubIssue"
    },
    "issue_ticket": {
      "$ref": "#/$defs/IssueTicket"
    },
    "plan_resolved": {
      "$ref": "#/$defs/PlanResolved"
    },
    "unavailable": {
      "$ref": "#/$defs/Unavailable"
    }
  },
  "$defs": {
    "Command": {
      "description": "The workflowtools subcommands, one per mise task.",
      "type": "string",
      "enum": [
        "frontmatter",
        "skill-table",
        "tickets",
        "settings-local"
      ]
    },
    "Frontmatter": {
      "description": "Check every SKILL.md and okf concept file's frontmatter, and that every YAML file parses, as the index has them.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "SkillTable": {
      "description": "Check the workflow docs' skills.md against the user-scope mattpocock-skills plugin install.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Listing": {
      "description": "Which tickets to print after a clean check.",
      "type": "string",
      "enum": [
        "frontier",
        "open"
      ]
    },
    "Tickets": {
      "description": "Check the roadmap's ticket lines against GitHub; list, rebuild or resolve a plan.",
      "type": "object",
      "properties": {
        "roadmap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Roadmap file; default <main checkout>/task_plan.md"
        },
        "spec": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "listing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Listing"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "After a clean check, print the tickets ready to start (frontier) or not yet finished (open)"
        },
        "rebuild": {
          "type": "boolean",
          "default": false
        },
        "require_github": {
          "type": "boolean",
          "default": false,
          "description": "Exit 2 unless the scope was checked against GitHub"
        },
        "plan": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "SettingsLocal": {
      "description": "Refuse a .claude/settings.local.json in this worktree, in the main checkout, or in the index.",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "Options": {
      "description": "What a workflowtools command parses from its arguments.",
      "anyOf": [
        {
          "$ref": "#/$defs/Frontmatter"
        },
        {
          "$ref": "#/$defs/SkillTable"
        },
        {
          "$ref": "#/$defs/Tickets"
        },
        {
          "$ref": "#/$defs/SettingsLocal"
        }
      ]
    },
    "Check": {
      "description": "The check a finding comes from.",
      "type": "string",
      "enum": [
        "frontmatter",
        "skill-table",
        "tickets",
        "settings-local"
      ]
    },
    "Finding": {
      "description": "One problem, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File, relative to the repository root; settings-local names an absolute path in another checkout"
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "detail": {
          "type": "string",
          "description": "What is wrong"
        }
      },
      "required": [
        "path",
        "check",
        "detail"
      ],
      "additionalProperties": false
    },
    "Skipped": {
      "description": "A check with nothing to compare, printed as a JSON line on stdout.",
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "reason": {
          "type": "string",
          "description": "Why it compared nothing"
        }
      },
      "required": [
        "check",
        "reason"
      ],
      "additionalProperties": false
    },
    "Failure": {
      "description": "Why a command stopped, printed as a JSON line on stderr.",
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "The message"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "SkillFrontmatter": {
      "description": "The SKILL.md frontmatter keys every harness needs; others pass.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The skill name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "When the skill applies",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": true
    },
    "OkfFrontmatter": {
      "description": "An okf concept file's frontmatter: a type; others pass.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "The concept type",
          "minLength": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "PluginManifest": {
      "description": "The part of a Claude Code plugin's .claude-plugin/plugin.json read here.",
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Skill folders, relative to the plugin root"
        }
      },
      "required": [
        "skills"
      ],
      "additionalProperties": true
    },
    "PluginRecord": {
      "description": "One install of a plugin in ~/.claude/plugins/installed_plugins.json.",
      "type": "object",
      "properties": {
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "user, project or local"
        },
        "projectPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The project a project-scoped install belongs to"
        },
        "installPath": {
          "type": "string",
          "description": "Where the plugin's files are"
        },
        "gitCommitSha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The plugin commit installed"
        }
      },
      "required": [
        "installPath"
      ],
      "additionalProperties": true
    },
    "InstalledPlugins": {
      "description": "~/.claude/plugins/installed_plugins.json, the part read here.",
      "type": "object",
      "properties": {
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PluginRecord"
            }
          },
          "description": "Installs by plugin id"
        }
      },
      "required": [
        "plugins"
      ],
      "additionalProperties": true
    },
    "IssueState": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "GitHubIssue": {
      "description": "The issue fields read from GitHub; other API fields pass.",
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/IssueState"
        },
        "html_url": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "title",
        "state",
        "html_url"
      ],
      "additionalProperties": true
    },
    "IssueTicket": {
      "description": "One ticket line in a roadmap spec section.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "ticket"
        },
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "spec": {
          "type": "integer"
        },
        "line": {
          "type": "integer"
        },
        "checked": {
          "type": "boolean"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/IssueState"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "number",
        "title",
        "url",
        "spec",
        "line",
        "checked",
        "plan_id",
        "blocked_by",
        "state"
      ],
      "additionalProperties": false
    },
    "PlanResolved": {
      "description": "An existing named plan resolved without writing or calling GitHub.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "plan"
        },
        "plan_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "issue": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "plan_id",
        "path",
        "issue",
        "url"
      ],
      "additionalProperties": false
    },
    "Unavailable": {
      "description": "GitHub could not provide a verified answer.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "github-unavailable"
        },
        "check": {
          "$ref": "#/$defs/Check"
        },
        "repo": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "check",
        "repo",
        "detail"
      ],
      "additionalProperties": false
    }
  }
}
