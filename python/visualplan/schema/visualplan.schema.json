{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "A plan.json; mise run //visualplan:codegen writes src/visualplan/models.py from this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "status", "claims", "decisions", "tests"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/Status"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/Claim"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/Decision"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/PlanTest"}}
  },
  "$defs": {
    "Status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "updated", "state", "next"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "updated": {
          "type": "string",
          "description": "When the plan last changed, in UTC: 2026-11-06T15:04Z.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"
        },
        "state": {"$ref": "#/$defs/State"},
        "next": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "State": {"type": "string", "enum": ["waiting_on_you", "working", "done"]},
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "where": {"$ref": "#/$defs/Where"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/Claim"}}
      }
    },
    "Where": {"type": "string", "description": "A source position, path:line.", "pattern": "^[^:]+:[0-9]+$"},
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "recommended", "alternatives"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "description": "The id of the claim the decision changes.", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "recommended": {"$ref": "#/$defs/Option", "description": "The option you would build."},
        "alternatives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Option"}}
      }
    },
    "Option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "why"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1}
      }
    },
    "PlanTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/Result"}
      }
    },
    "Result": {"type": "string", "enum": ["not_run", "fail", "pass"]},
    "Wrote": {
      "type": "object",
      "description": "The JSON line render prints on stdout when it wrote the page.",
      "additionalProperties": false,
      "required": ["wrote"],
      "properties": {"wrote": {"type": "string"}}
    },
    "Failure": {
      "type": "object",
      "description": "The JSON line render prints on stderr when it refuses the plan or cannot write the page.",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {"error": {"type": "string"}}
    }
  }
}
