+// jbctl patch (dotfiles#502): Java/Swing (JBR) puts accessible names in AXDescription, not AXTitle.
+func label(_ element: AXUIElement) -> Any {
+  if let t = attribute(element, kAXTitleAttribute) as? String, !t.isEmpty { return t }
+  if let d = attribute(element, kAXDescriptionAttribute) as? String, !d.isEmpty { return d }
+  return NSNull()
