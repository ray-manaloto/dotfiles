{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(gh pr create *)",
      "Bash(mise run //repo:pr-create *)",
      "Bash(mise run //python/repo:pr-create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)"
    ]
  },
  "enabledPlugins": {
    "code-modernization@claude-plugins-official": true
  },
  "skillOverrides": {
    "agent-desktop": "off"
  },
  "attribution": {
    "sessionUrl": false
  }
}
