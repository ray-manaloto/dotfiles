amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    // A blank context line in a patch is a single space; stripping it would break the patch.
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = "**/*.patch" }
    ["newlines"] = Builtins.newlines
    ["merge-conflicts"] = Builtins.check_merge_conflict
    // Secrets, as risu729/dotfiles does; this machine's home path through mise vars (tasks/privacy/scan.sh).
    ["betterleaks"] = Builtins.betterleaks
    ["private-paths"] {
        check = "mise run privacy:scan -- {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    // Every commit a push would publish, branches and tags alike, never only the pushed range.
    ["pre-push"] {
        steps {
            ["private-paths"] {
                exclusive = true
                check = "mise run privacy:scan --outgoing"
            }
        }
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
