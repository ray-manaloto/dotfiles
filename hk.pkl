amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

// Commit-time checks: file-level linters that take seconds. pre-commit runs these only (owner, 2026-11-13).
local fast = new Mapping<String, Step> {
    // A blank context line in a patch is a single space; stripping it would break the patch.
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = "**/*.patch" }
    ["newlines"] = Builtins.newlines
    ["merge-conflicts"] = Builtins.check_merge_conflict
    // Secrets, as risu729/dotfiles does; this machine's home path through mise vars (repotools privacy-scan).
    // aube lock graphs are generated registry metadata: package names such as @inquirer/password read as secrets.
    ["betterleaks"] = (Builtins.betterleaks) { exclude = "unix/home/.config/mise/locks/**/aube-lock.yaml" }
    ["shellcheck"] = Builtins.shellcheck
    ["private-paths"] {
        check = "mise run privacy:scan -- {{files}}"
    }
    // swift/ (jbax, #502): SwiftLint as hk's builtin; swift format, build and the non-live tests through the root's
    // mise task. The live-IDE coverage gate (//swift:coverage) brings the IDE forward, so it is never a hook.
    ["swiftlint"] = (Builtins.swiftlint) {
        glob = List("swift/**/*.swift")
        // macOS only, like jbax and its swiftlint pin (os = ["macos"] in the global mise config).
        condition = "exec_ok('test \"$(uname -s)\" = Darwin')"
    }
    // SKILL.md and okf concept frontmatter, and YAML that parses: the whole index, as a commit would hold it.
    ["frontmatter"] {
        glob = List("**/*.md", "**/*.yml", "**/*.yaml")
        check = "mise run frontmatter"
    }
    // Agent-config linters (docs/research/agent-config-linters.md). Both steps run their tool through
    // `mise x <backend>`, which takes the global pin, so a stale shim of the same name can't answer instead.
    ["agnix"] {
        glob = List(
            "**/AGENTS.md",
            "**/CLAUDE.md",
            "**/SKILL.md",
            ".claude/**",
            ".agnix.toml",
            "unix/home/.codex/**",
            "unix/home/.config/opencode/**"
        )
        check = "mise x github:agent-sh/agnix -- agnix {{files}}"
    }
    // cclint covers Claude files only and reports without failing the hook (hk 2.12.0 Config.pkl:827-842).
    ["cclint"] {
        // It validates .md and .json files only.
        glob = List("**/CLAUDE.md", ".claude/**/*.md", ".claude/**/*.json", "unix/home/.config/agents/skills/**/*.md")
        check = "mise x go:github.com/dotcommander/cclint -- cclint lint {{files}}"
        allow_failure = true
    }
    // GitHub Actions (owner rule, 2026-11-13): jactionlint for correctness, never actionlint, and zizmor beside it for
    // security. Both are hk builtins on the workflow files; the tools are global mise pins.
    ["jactionlint"] = Builtins.jactionlint
    ["zizmor"] = Builtins.zizmor
    // AGENTS.md zero bash: lists the leftovers in hk's files without failing until the last port adds --strict. At
    // pre-commit hk stashes unstaged work, so the files it reads are the staged ones. The glob makes hk skip a
    // commit whose files were all deleted (hk 2.12.0 src/step/runner.rs:170-175) instead of passing it no files,
    // which would list the whole repository.
    ["zero-bash"] {
        glob = List("**")
        check = "mise run zero-bash -- {{files}}"
    }
    // `fnox set` on a doppler provider writes the value into the TOML in plain text: a tracked fnox file's Doppler
    // entries must hold Doppler secret names (repotools fnox-refs). It reads the index, so it runs on every commit.
    ["fnox-refs"] {
        check = "mise run fnox-refs"
    }
    // A git command run with a hook's GIT_DIR (a test's `git init`, say) can write core.worktree into the shared
    // .git/config, and every checkout of the repo then reads and writes another worktree's files. Nothing here sets it
    // on purpose, so any value stops the commit. No glob: it runs on every commit.
    ["no-core-worktree"] {
        check = "test -z \"$(git config --file \"$(git rev-parse --git-common-dir)/config\" --get-all core.worktree)\" || { echo 'core.worktree is set in the shared .git/config: remove it with git config --file <common dir>/config --unset-all core.worktree' >&2; exit 1; }"
    }
}

// Package checks (lint, types, codegen and 100%-coverage tests through each root's mise task): pre-push runs the
// ones whose files the push changes, as hk selects a pre-push step's files from the pushed range (owner, 2026-11-13: a
// commit took minutes, and every suite at once on 12 xdist workers drove the load past 200 on 12 cores).
local suites = new Mapping<String, Step> {
    // DL-758: the p2996 package's ruff, ty, codegen drift and 100% coverage gate, through its mise task.
    ["p2996"] {
        glob = List("python/toolchains/p2996/**")
        check = "mise run //p2996:check"
    }
    // The lsptools package (mise run lsp): ruff, ty, codegen drift and 100% coverage, with the file task it runs from.
    ["lsp"] {
        glob = List("python/lsp/**", "unix/home/.config/mise/tasks/lsp")
        check = "mise run //lsp:check"
    }
    // DL-758: the hometools package (#391, the global toolchain tasks), as p2996, and the file tasks and
    // config it checks, on a scratch copy of this Mac's toolchain; pre-commit adds the real-toolchain test.
    ["home"] {
        glob = List(
            "python/home/**",
            "unix/home/.config/mise/tasks/toolchain/**",
            "unix/home/.config/mise/tasks/bootstrap/**",
            "unix/home/.config/mise/config.toml"
        )
        check = "mise run //home:unit"
    }
    // The herdr doctor and hc-safe (docs/agents/herdr-core.md): lint and their unit and contract tests, never a live
    // check. Off in CI: the stand-ins and Unix sockets they test with are macOS-only.
    ["herdr"] {
        glob = List(
            "unix/home/.config/mise/tasks/herdr/**",
            "unix/home/.local/bin/hc-safe",
            "python/home/src/hometools/herdr.py",
            "python/home/tests/test_herdr_*",
            ".claude/skills/verify/SKILL.md",
            "python/home/mise.toml"
        )
        profiles = List("!ci")
        check = "mise run //home:herdr-unit"
    }
    // python/tests reads the shared agent rules (a hash pin of the research section) and starts real zsh from the
    // startup files, so a change to either runs them. Off in CI, where the
    // test task runs them anyway (#472).
    ["python-tests"] {
        glob = List("unix/home/.config/agents/**", "unix/home/.config/zsh/**", "unix/home/.zshenv")
        profiles = List("!ci")
        check = "mise run //python:test"
    }
    ["cbm"] {
        glob = List("python/cbm/**")
        check = "mise run //cbm:check"
    }
    // The rule-guard hook and the Codex rules file its tests check with the real `codex execpolicy check`. The
    // Gemini policy file reruns the same check but no test loads it in Gemini yet.
    ["guards"] {
        glob = List("python/guards/**", "unix/home/.codex/rules/**", "unix/home/.gemini/policies/**")
        check = "mise run //guards:check"
    }
    // python/jbctl (#502): lint and the non-live tests; the live 100% gate (//jbctl:coverage) brings the IDE forward.
    ["jbctl"] {
        glob = List("python/jbctl/**")
        check = "mise run //jbctl:check"
    }
    // depmaps is out of `mise run test` and bootstrap, so this is what runs its tests: the real cbm, isolated per test.
    ["depmaps"] {
        glob = List("python/depmaps/**")
        check = "mise run //depmaps:check"
    }
    ["swift"] {
        glob = List("swift/**")
        check = "mise run //swift:check"
    }
    // The fnox and Doppler checks (doctor/mise.toml), only when the fnox files or doctor/ change, so an
    // ordinary commit makes no Keychain or Doppler call. Off in CI: it has neither.
    ["secret-doctor"] {
        glob = List("unix/home/.config/fnox/**", "doctor/**")
        profiles = List("!ci")
        check = "mise -C doctor doctor project"
    }
}

// Files every package's checks read. `hk check` (pr-merge runs `hk check --pr`, the pull request's changed files)
// runs every suite when one of these changes; pre-push keeps the suites' own globs, so a lock bump pushes fast.
// secret-doctor stays on its own files: it calls the Keychain and Doppler.
local shared = List(
    "mise.toml",
    "mise.lock",
    "hk.pkl",
    ".github/workflows/**",
    "unix/home/.config/mise/config.toml"
)
local checkSuites: Mapping<String, Step> = suites.toMap()
    .mapValues((name, s) -> if (name == "secret-doctor") s else (s) { glob = (s.glob as List<String>) + shared })
    .toMapping()

// Names the fallback in hk check's output (pr-merge's log): it runs only when a shared file is among the checked
// files, and says which. Without this line, hk's "Fetching files between origin/main and HEAD" shows the --pr mode.
local fallbackNote = new Mapping<String, Step> {
    ["shared-files"] {
        glob = shared
        check = "echo 'every suite runs: shared files changed: {{files}}'"
    }
}

local linters: Mapping<String, Step> = (fast.toMap() + checkSuites.toMap() + fallbackNote.toMap()).toMapping()

// At most two steps at a time; root mise.toml caps pytest -n auto at 4 workers (PYTEST_XDIST_AUTO_NUM_WORKERS).
jobs = 2

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = (fast) {
            // AGENTS.md: main moves only to origin/main. This names the rule before the linters run; the
            // reference-transaction hook (mise run main-guard-install) also stops reset, branch -f and HK=0.
            ["no-commit-to-main"] = Builtins.no_commit_to_branch
            // #391: the real-toolchain test (//home:integration) only, for a commit that reaches the toolchain tasks
            // or the global config; the rest of //home runs at pre-push (//home:unit). A commit that only deletes such
            // files skips it: hk leaves deleted files out of a step's files (hk 2.12.0 src/git.rs:4336-4357) and skips
            // a filtered step with none (src/step/runner.rs:170-175). //home:unit at pre-push still covers python/home.
            ["toolchain-gate"] {
                glob = List(
                    "python/home/**",
                    "unix/home/.config/mise/tasks/toolchain/**",
                    "unix/home/.config/mise/tasks/bootstrap/**",
                    "unix/home/.config/mise/config.toml"
                )
                check = "mise run //home:integration"
            }
        }
    }
    // The package checks for the files the push changes. The private-paths scan covers every commit a push would
    // publish, branches and tags alike, never only the pushed range.
    ["pre-push"] {
        steps = (suites) {
            ["private-paths-outgoing"] {
                exclusive = true
                check = "mise run privacy:scan --outgoing"
            }
            // The suites run real git in scratch repositories. If a hook variable ever reaches them again (a linked
            // worktree gives pre-push GIT_DIR, #694), the core.worktree they write fails the push, not a later commit.
            ["no-core-worktree"] = (fast["no-core-worktree"]) { exclusive = true }
        }
    }
    ["post-merge"] {
        steps {
            // mise's records of worktree copies of the global config make mise reshim and install warn
            // (mise:untrack-worktrees in the global config); a merge is when a worktree's work ends.
            ["mise-untrack-worktrees"] {
                check = "mise run mise:untrack-worktrees"
            }
            // A merge into main in the checkout the home links to applies its [dotfiles] entries; anywhere else it
            // skips (tasks/skills/apply). Never --force or --prune: a real file in the way fails with mise's error. The
            // five permission entries are left to the owner (skills:doctor PERMISSIONS names them).
            ["dot-apply"] {
                depends = "mise-untrack-worktrees"
                check = "mise run skills:apply"
            }
            // A merge can move a tool pin: install it and rerun the post-tools hook (the skills at their pinned tags),
            // after the untrack step so mise warns about no worktree copy (owner ruling, 2026-11-17).
            ["bootstrap-tools"] {
                depends = "dot-apply"
                check = "mise bootstrap --only tools --yes"
            }
            // Then check the home against the checkout: each failed line names the command that fixes it. git ignores
            // post-merge's status, so that line is all a failure leaves. hk starts no dependent after a failed step
            // (v2.13.0 src/step/execution.rs:138-141), so a failed bootstrap shows its own error instead.
            ["skills-doctor"] {
                depends = "bootstrap-tools"
                check = "mise run skills:doctor"
            }
            // A merge that moved the rea pin installs the new package (//jbctl:rea-install). hk 2.12.0 selects a
            // post-merge step's files from the working tree, not the merge, so the step asks git itself: `git diff
            // --quiet` exits 1 only when ORIG_HEAD..HEAD differ at the pin (128 when ORIG_HEAD is missing, so no run).
            ["rea-install"] {
                step_condition = "exec_ok('git diff --quiet ORIG_HEAD HEAD -- python/jbctl/src/jbctl/data/rea-pin.json; test $? -eq 1')"
                check = "mise run //jbctl:rea-install"
            }
        }
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
