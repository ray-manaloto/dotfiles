amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    // A blank context line in a patch is a single space; stripping it would break the patch.
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = "**/*.patch" }
    ["newlines"] = Builtins.newlines
    ["merge-conflicts"] = Builtins.check_merge_conflict
    // Secrets, as risu729/dotfiles does; this machine's home path through mise vars (tasks/privacy/scan.sh).
    ["betterleaks"] = Builtins.betterleaks
    ["shellcheck"] = Builtins.shellcheck
    ["private-paths"] {
        check = "mise run privacy:scan -- {{files}}"
    }
    // DL-758: the p2996 package's ruff, ty, codegen drift and 100% coverage gate, through its mise task.
    ["p2996"] {
        glob = List("python/toolchains/p2996/**")
        check = "mise run //p2996:check"
    }
    ["repo"] {
        glob = List("python/repo/**")
        check = "mise run //repo:check"
    }
    ["workflow"] {
        glob = List("python/workflow/**")
        check = "mise run //workflow:check"
    }
    // SKILL.md and okf concept frontmatter, and YAML that parses: the whole index, as a commit would hold it.
    ["frontmatter"] {
        glob = List("**/*.md", "**/*.yml", "**/*.yaml")
        check = "mise run //workflow:frontmatter"
    }
    // AGENTS.md zero bash: lists the leftovers without failing until the last port adds --strict.
    ["zero-bash"] {
        check = "mise run //repo:zero-bash"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = (linters) {
            // AGENTS.md: main moves only to origin/main. This names the rule before the linters run; the
            // reference-transaction hook (//repo:main-guard-install) also stops reset, branch -f and HK=0.
            ["no-commit-to-main"] = Builtins.no_commit_to_branch
            // AGENTS.md: review:python must pass first. Only compares a fingerprint, so no Codex run here.
            ["python-review"] {
                glob = List("python/**")
                check = "mise run review:python:approved"
            }
        }
    }
    // Every commit, docs included: the pinned reviewer pane's last answer approves this HEAD, index and message.
    // The public repo's leak check: the reviewer refuses challenge content (AGENTS.md). Here, not in pre-commit,
    // because pre-commit runs before the message exists; commit-msg sees it after preparation and editing.
    ["commit-msg"] {
        steps {
            ["pane-approval"] {
                // hk inserts the path as raw text (hk src/tera.rs:8-12); single quotes, each ' as '\'', keep it one word.
                check = #"mise run //repo:pane-approved '{{ commit_msg_file | replace(from="'", to="'\''") }}'"#
            }
        }
    }
    // Every commit a push would publish, branches and tags alike, never only the pushed range.
    ["pre-push"] {
        steps {
            ["private-paths"] {
                exclusive = true
                check = "mise run privacy:scan --outgoing"
            }
        }
    }
    // AGENTS.md main guard: a fast-forward of main to a new guard source installs it (//repo:main-guard-arm).
    ["post-merge"] {
        steps {
            ["main-guard"] {
                check = "mise run //repo:main-guard-arm"
            }
        }
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
