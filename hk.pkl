amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    // A blank context line in a patch is a single space; stripping it would break the patch.
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) { exclude = "**/*.patch" }
    ["newlines"] = Builtins.newlines
    ["merge-conflicts"] = Builtins.check_merge_conflict
    // Secrets, as risu729/dotfiles does; this machine's home path through mise vars (repotools privacy-scan).
    ["betterleaks"] = Builtins.betterleaks
    ["shellcheck"] = Builtins.shellcheck
    ["private-paths"] {
        check = "mise run privacy:scan -- {{files}}"
    }
    // DL-758: the p2996 package's ruff, ty, codegen drift and 100% coverage gate, through its mise task.
    ["p2996"] {
        glob = List("python/toolchains/p2996/**")
        check = "mise run //p2996:check"
    }
    ["repo"] {
        glob = List("python/repo/**")
        check = "mise run //repo:check"
    }
    ["workflow"] {
        glob = List("python/workflow/**")
        check = "mise run //workflow:check"
    }
    // DL-758: the hometools package (#391, the global toolchain tasks), as p2996, and the file tasks and
    // config it checks, on a scratch copy of this Mac's toolchain; pre-commit adds the real-toolchain test.
    ["home"] {
        glob = List(
            "python/home/**",
            "unix/home/.config/mise/tasks/toolchain/**",
            "unix/home/.config/mise/tasks/bootstrap/**",
            "unix/home/.config/mise/config.toml"
        )
        check = "mise run //home:unit"
    }
    // The herdr doctor and hc-safe (docs/agents/herdr-core.md): lint and their unit and contract tests, never a live
    // check. Off in CI: the stand-ins and Unix sockets they test with are macOS-only.
    ["herdr"] {
        glob = List(
            "unix/home/.config/mise/tasks/herdr/**",
            "unix/home/.local/bin/hc-safe",
            "python/home/src/hometools/herdr.py",
            "python/home/tests/test_herdr_*",
            ".claude/skills/verify/SKILL.md",
            "python/home/mise.toml"
        )
        profiles = List("!ci")
        check = "mise run //home:herdr-unit"
    }
    // python/tests reads the shared agent rules (a hash pin of the research section) and starts real zsh from the
    // startup files, so a change to either runs them, as //repo:check does for python/repo. Off in CI, where the
    // test task runs them anyway (#472).
    ["python-tests"] {
        glob = List("unix/home/.config/agents/**", "unix/home/.config/zsh/**", "unix/home/.zshenv")
        profiles = List("!ci")
        check = "mise run //python:test"
    }
    ["cbm"] {
        glob = List("python/cbm/**")
        check = "mise run //cbm:check"
    }
    // The rule-guard hook and the Codex rules file its tests check with the real `codex execpolicy check`. The
    // Gemini policy file reruns the same check but no test loads it in Gemini yet.
    ["guards"] {
        glob = List("python/guards/**", "unix/home/.codex/rules/**", "unix/home/.gemini/policies/**")
        check = "mise run //guards:check"
    }
    // python/jbctl (#502): lint and the non-live tests; the live 100% gate (//jbctl:coverage) brings the IDE forward.
    ["jbctl"] {
        glob = List("python/jbctl/**")
        check = "mise run //jbctl:check"
    }
    // depmaps is out of `mise run test` and bootstrap, so this is what runs its tests: the real cbm, isolated per test.
    ["depmaps"] {
        glob = List("python/depmaps/**")
        check = "mise run //depmaps:check"
    }
    // swift/ (jbax, #502): SwiftLint as hk's builtin; swift format, build and the non-live tests through the root's
    // mise task. The live-IDE coverage gate (//swift:coverage) brings the IDE forward, so it is never a hook.
    ["swiftlint"] = (Builtins.swiftlint) {
        glob = List("swift/**/*.swift")
        // macOS only, like jbax and its swiftlint pin (os = ["macos"] in the global mise config).
        condition = "exec_ok('test \"$(uname -s)\" = Darwin')"
    }
    ["swift"] {
        glob = List("swift/**")
        check = "mise run //swift:check"
    }
    // SKILL.md and okf concept frontmatter, and YAML that parses: the whole index, as a commit would hold it.
    ["frontmatter"] {
        glob = List("**/*.md", "**/*.yml", "**/*.yaml")
        check = "mise run //workflow:frontmatter"
    }
    // AGENTS.md zero bash: lists the leftovers without failing until the last port adds --strict.
    ["zero-bash"] {
        check = "mise run //repo:zero-bash"
    }
    // `fnox set` on a doppler provider writes the value into the TOML in plain text: a tracked fnox file's Doppler
    // entries must hold Doppler secret names (repotools fnox-refs). It reads the index, so it runs on every commit.
    ["fnox-refs"] {
        check = "mise run //repo:fnox-refs"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = (linters) {
            // AGENTS.md: main moves only to origin/main. This names the rule before the linters run; the
            // reference-transaction hook (//repo:main-guard-install) also stops reset, branch -f and HK=0.
            ["no-commit-to-main"] = Builtins.no_commit_to_branch
            // #391: //home:check, the real-toolchain test included, for a commit that reaches the toolchain tasks.
            // No glob: hk drops a filtered step whose files were all deleted; toolchain-gate picks the paths.
            ["home"] {
                glob = null
                check = "mise run //repo:toolchain-gate"
            }
            // As home: no glob, so a commit that only deletes a herdr file still runs it; herdr-gate picks the paths.
            ["herdr"] {
                glob = null
                profiles = List("!ci")
                check = "mise run //repo:herdr-gate"
            }
            // AGENTS.md: review:python must pass first. Only compares a fingerprint, so no Codex run here.
            ["python-review"] {
                glob = List("python/**")
                check = "mise run review:python:approved"
            }
        }
    }
    // Every commit, docs included: the pinned reviewer pane's last answer approves this HEAD, index and message.
    // The public repo's leak check: the reviewer refuses challenge content (AGENTS.md). Here, not in pre-commit,
    // because pre-commit runs before the message exists; commit-msg sees it after preparation and editing.
    ["commit-msg"] {
        steps {
            ["pane-approval"] {
                // hk inserts the path as raw text (hk src/tera.rs:8-12); single quotes, each ' as '\'', keep it one word.
                check = #"mise run //repo:pane-approved '{{ commit_msg_file | replace(from="'", to="'\''") }}'"#
            }
        }
    }
    // Every commit a push would publish, branches and tags alike, never only the pushed range.
    ["pre-push"] {
        steps {
            ["private-paths"] {
                exclusive = true
                check = "mise run privacy:scan --outgoing"
            }
        }
    }
    // AGENTS.md main guard: a fast-forward of main to a new guard source installs it (//repo:main-guard-arm).
    ["post-merge"] {
        steps {
            ["main-guard"] {
                check = "mise run //repo:main-guard-arm"
            }
        }
    }
    ["check"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
}
