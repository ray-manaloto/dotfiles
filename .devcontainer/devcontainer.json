// Two-layer build hierarchy:
//
//   .devcontainer/Dockerfile            ← base image (CI-only per
//                                         feedback_base_image_ci_only.md).
//                                         Published to
//                                         ghcr.io/ray-manaloto/dotfiles-devcontainer:dev
//                                         by .github/workflows/ci.yml on
//                                         merges to main. Never build
//                                         locally.
//        │
//        ▼ (FROM ${BASE_IMAGE})
//
//   .devcontainer/Dockerfile.host-user  ← thin overlay (local build on
//                                         every `mise run up`). Adds
//                                         host-user rename + home staging.
//                                         ≤89 lines enforced by
//                                         hk.pkl:dockerfile_host_user_thin_overlay.
//
// BASE_IMAGE default comes from mise.toml [tasks.up].env. Override
// per-clone via mise.local.toml (see mise.local.toml.example).
//
// ===============================================================
// TWO independent SSH requirements, TWO mechanisms:
//
// (R1) INBOUND shell: `ssh ${USER}@localhost -p $(mise run ssh-port)` from host
//      opens a shell into the container. Provided by:
//      - `features.ghcr.io/devcontainers/features/sshd` — installs
//        openssh-server. NOTE: the feature's `port`/`username`/`startNow`
//        options are silently dropped (see research report); sshd
//        listens on its hardcoded **2222** internally. External port is
//        `${DEVCONTAINER_SSH_PORT}` via `appPort` — derived per
//        workspace+architecture (#677), or pinned in mise.local.toml.
//      - `postCreateCommand` copies the host user's authorized keys
//        (pre-written by `dotfiles-setup docker initialize-host` on the
//        host from `ssh-add -L`) into `~/.ssh/authorized_keys` so the
//        container sshd can authenticate the Mac user.
//
// (R2) OUTBOUND agent: `ssh -T git@github.com` inside the container
//      reaches the host's launchd SSH agent via Docker Desktop's
//      native `/run/host-services/ssh-auth.sock` magic socket,
//      bind-mounted into the container and pointed at by
//      `containerEnv.SSH_AUTH_SOCK`. The socket arrives as
//      root:root 0660 and must be chowned to the container user.
//      This chown runs in BOTH `postCreateCommand` (so first-create
//      smoke, which runs inside postCreate, sees an accessible socket)
//      AND `postStartCommand` (so the chown is re-established on EVERY
//      container start). The latter is load-bearing: Docker Desktop
//      recreates the host-services socket as root:root on reboot / DD
//      restart / update, and `mise run up` reuses an existing container
//      WITHOUT re-running postCreateCommand — so a create-only chown is
//      silently lost across restarts and R2 breaks. postStartCommand
//      runs on every `devcontainer up` (per devcontainers/cli docs),
//      closing that gap. No host-side or container-side proxy required.
//      Runtime pin: Docker Desktop only — Colima has no equivalent
//      (`abiosoft/colima#1330`, `#942`); deferred follow-up #78.
//
// Research + rationale:
//   docs/research/runs/research-20260409c-dockerdesktop-ssh/report.md
//
// ===============================================================
// (S1) SECRETS injection via Doppler:
//
// `initializeCommand` (host-side) runs `dotfiles-setup docker
// initialize-host`, which downloads the KEY=VALUE env file to
// ~/.local/state/dotfiles/doppler-<hash>-<arch>.env. `runArgs
// --env-file` injects all secrets as container env vars at creation
// time. No doppler CLI needed inside the container.
//
// #893: the filename carries this workspace's hash and architecture.
// It used to be a bare `doppler.env`, shared by every clone and both
// arches on the host, written with an unlocked `>`-truncate — so two
// concurrent `up`s could hand a container the OTHER clone's secrets,
// silently. The write is now atomic (temp + rename) as well.
//
// Doppler project/config defaults come from mise.toml [tasks.up].env
// (DOPPLER_PROJECT=dotfiles, DOPPLER_CONFIG=dev_personal). Override
// per-clone via mise.local.toml. Aligned onto dev_personal 2026-08-03:
// dev was a strict subset (43 of 49) and the 6 extras are host-side
// consumers, so the split bought nothing the container could use while
// costing a second name set nothing asserted. Future: migrate to
// mise-env-fnox integration with doppler provider in-container (#83).
// ===============================================================
{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  // #677: the container/volume/port names are RESOLVED, never composed here.
  // `mise run up` evals `dotfiles-setup devcontainer env`, which derives all
  // of them — including the architecture word, which must come from
  // platform_target and never from a literal (`no_platform_literals`). A JSON
  // string is also the one place a reviewer cannot see an arch is missing.
  "name": "${localEnv:DEVCONTAINER_NAME}",
  "build": {
    "dockerfile": "Dockerfile.host-user",
    // #673: the platform is ONE parameter — mise.toml's global
    // [env] DOTFILES_PLATFORM. `${localEnv:...}` interpolates inside array
    // elements (same mechanism as runArgs below). Deliberately WITHOUT a
    // `:default` fallback: a fallback here would be a second platform
    // literal, and the whole point is that exactly one place chooses. Bring
    // the container up via `mise run up`, which supplies it.
    // The --tag is per clone+arch, from the same `mise run up` env as
    // "name" above. The CLI's own vsc-<folder-hash> tag is shared by both
    // architectures, so without it the second arch's build orphans the
    // first container's image (verify-arch: "No such image"; #678).
    "options": ["--tag=vsc-dotfiles-${localEnv:DEVCONTAINER_WORKSPACE_HASH}-${localEnv:DEVCONTAINER_ARCH}", "--platform=${localEnv:DOTFILES_PLATFORM}"],
    "args": {
      "DEVCONTAINER_USER": "${localEnv:USER}",
      "BASE_IMAGE": "${localEnv:BASE_IMAGE}",
    },
  },
  "runArgs": [
    "--name",
    "${localEnv:DEVCONTAINER_NAME}",
    "--env-file",
    // #893: RESOLVED, never composed here — the path carries this
    // workspace's hash and arch, so two concurrent `up`s cannot share it.
    // Supplied by `mise run up` via `dotfiles-setup devcontainer env`.
    "${localEnv:DEVCONTAINER_ENV_FILE}",
    "--platform=${localEnv:DOTFILES_PLATFORM}",
  ],
  "remoteUser": "${localEnv:USER}",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.local/state/dotfiles,target=/tmp/dotfiles-host-state,type=bind",
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    // Architecture-scoped (#677). The home volume carries compiled output —
    // ~/.local/share/mise/installs, ~/.cargo, ~/.rustup — so sharing one
    // across architectures interleaves binaries silently: docker reuses a
    // named volume on mount and reports nothing.
    "source=${localEnv:DEVCONTAINER_HOME_VOLUME},target=/home/${localEnv:USER},type=volume",
  ],
  "containerEnv": {
    // ─ Platform hints ────────────────────────────────────────────────
    // MISE_ARCH / MISE_OS / CONDA_SUBDIR REMOVED (#698). They were here for
    // "runtime visibility for user shells", and the duplication with
    // mise-system.toml [env] was deliberate. Both are now deleted: MISE_ARCH is
    // the environment spelling of mise's `arch` SETTING, not a display hint, so
    // in containerEnv it reached every process in the container — every runtime
    // `mise install`, including the user overlay tier on-create.sh installs
    // eagerly. On an arm64 container that resolved x86_64 tools, which is the
    // exact defect #698 exists to remove, one layer further out than the build.
    // A running container already IS its own architecture and IS linux.

    // ─ Container-private python venv (review finding [33], 2026-07-07) ─
    // The workspace bind mount would otherwise share python/.venv between
    // the macOS host and this linux container: the interpreters are
    // incompatible (each side "repairs" the venv, clobbering the other)
    // and CONCURRENT host+container uv runs race on the same directory —
    // probe-observed: an in-container `uv sync` failed with a dist-info
    // rename ENOENT while host uv ran in parallel, killing the
    // persistence gate. uv's documented env var points the project venv
    // at the persistent home volume instead — no bind-mount sharing.
    "UV_PROJECT_ENVIRONMENT": "/home/${localEnv:USER:devcontainer}/.venvs/dotfiles-python",

    // ─ Config trust + discovery ──────────────────────────────────────
    // Trust ALL paths without prompting ("/" matches everything).
    // Required for non-interactive mise activation in user shells,
    // IDEs, and CI-equivalent jobs inside the container — no
    // `mise trust` prompt blocks. This OVERRIDES the narrower
    // build-time MISE_TRUSTED_CONFIG_PATHS=/usr/local/share/mise:/workspaces/dotfiles
    // set in Dockerfile ENV (line 62). Verified canonical mechanism per
    // mise docs (configuration.md MISE_TRUSTED_CONFIG_PATHS section).
    "MISE_TRUSTED_CONFIG_PATHS": "/",

    // Skip the host-shaped workspace mise.toml inside the container.
    // Its 46 user-tools are already provided by the system tree
    // (.devcontainer/mise-system.toml, baked into :dev). Without this
    // exclusion, mise would discover /workspaces/<basename>/mise.toml
    // via cwd-walking and — because auto_install=true is set in
    // user-overlay home/dot_config/mise/config.toml.tmpl — attempt to
    // install all 46 tools again into the user overlay, emitting
    // "WARN: not installed" for each. MISE_IGNORED_CONFIG_PATHS is the
    // path-axis opt-out (vs the older filename-axis MISE_OVERRIDE_CONFIG_FILENAMES,
    // which had the side-effect of blocking ALL `mise.toml` files
    // anywhere in the container). Verified jdx/mise@v2026.4.28 against
    // upstream HEAD: src/env.rs MISE_IGNORED_CONFIG_PATHS definition,
    // settings.toml [ignored_config_paths] section, src/config/mod.rs.
    // The second path ignores the workspace copy of the shared conf.d fragment
    // (#160 T5): the container gets those 20 tools from the COPYd system copy at
    // /usr/local/share/mise/conf.d/shared.toml, so the bind-mounted workspace
    // copy must NOT also load (preserves the "container reads the baked config,
    // never the host repo" isolation). Colon-separated, PATH-style.
    "MISE_IGNORED_CONFIG_PATHS": "/workspaces/${localWorkspaceFolderBasename}/mise.toml:/workspaces/${localWorkspaceFolderBasename}/.config/mise/conf.d/shared.toml",

    // System-config DIRECTORY discovery — deliberately no
    // MISE_SYSTEM_CONFIG_FILE. Per src/config/mod.rs
    // `system_config_files()`, setting the FILE short-circuits system
    // discovery to that ONE file, which hid conf.d/shared.toml (the 20
    // shared-tier tools, #160 T5) and config.runtime.toml (the runtime
    // tier, T9/T10) at runtime — `chezmoi init` onCreate failed with
    // "No version is set for shim: chezmoi" (PR #169). With only the
    // DIR set, mise discovers config.toml + config.runtime.toml +
    // conf.d/*.toml on the system axis (probe-verified in :pr-169).
    "MISE_SYSTEM_CONFIG_DIR": "/usr/local/share/mise",

    // Per-user mise config — path templated to host user's home. This
    // OVERRIDES the build-time MISE_CONFIG_DIR=/usr/local/share/mise
    // set in Dockerfile ENV (build-time uses the system path so
    // `mise install --system -y` finds the system config; runtime uses
    // per-user path so each user has their own overlay at
    // ~/.config/mise/config.toml). The two values cover different
    // windows; the override is intentional.
    "MISE_GLOBAL_CONFIG_FILE": "/home/${localEnv:USER}/.config/mise/config.toml",
    "MISE_CONFIG_DIR": "/home/${localEnv:USER}/.config/mise",

    // ─ Runtime markers ───────────────────────────────────────────────
    // Container-environment marker for chezmoi templates and other
    // tooling that needs to discriminate "inside the devcontainer (not
    // the Mac host)." chezmoi.os == "linux" is the canonical built-in
    // check, but DEVCONTAINER=true is the explicit signal for the
    // mise-overlay gate in home/.chezmoi.toml.tmpl. See
    // feedback_devcontainer_only_mise_overlay.md (auto-memory).
    "DEVCONTAINER": "true",

    // Docker Desktop's native magic socket for SSH agent forwarding
    // (R2 outbound: `ssh -T git@github.com` inside the container reaches
    // the host's launchd SSH agent — no host-side proxy needed). The
    // socket is bind-mounted via `mounts` above; this env var points
    // tools at it. Docker-Desktop-only — Colima has no equivalent
    // (`abiosoft/colima#1330`, #942; deferred follow-up #78). See
    // docs/research/runs/research-20260409c-dockerdesktop-ssh/report.md.
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock",
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
  },
  "appPort": ["${localEnv:DEVCONTAINER_SSH_PORT}:2222"],
  "forwardPorts": [2222],
  "updateRemoteUserUID": false,
  "init": true,
  // #893: the Doppler download moved INTO `docker initialize-host`. It was an
  // unlocked `>`-truncate to one host-wide path, so it needed a per-workspace
  // path AND an atomic write — more logic than belongs in a JSON string
  // (zero-bash-logic). The old `&& [ -s … ] &&` guard is now a
  // SecretsDownloadError, so an empty download still fails the bring-up.
  "initializeCommand": "uv run --project python dotfiles-setup docker initialize-host",
  "onCreateCommand": "bash /workspaces/${localWorkspaceFolderBasename}/.devcontainer/scripts/on-create.sh /workspaces/${localWorkspaceFolderBasename}",
  "postCreateCommand": "sudo chown ${localEnv:USER}:${localEnv:USER} /run/host-services/ssh-auth.sock && install -d -m 700 ~/.ssh && install -m 600 /tmp/dotfiles-host-state/authorized_keys ~/.ssh/authorized_keys && ssh-keyscan -t rsa,ecdsa,ed25519 github.com >> ~/.ssh/known_hosts && [ -s ~/.ssh/known_hosts ] && chmod 600 ~/.ssh/known_hosts && scripts/devcontainer-smoke.sh",
  // Re-chown the Docker Desktop magic SSH socket on EVERY container
  // start (R2 outbound). postCreateCommand runs once on create; the
  // socket reverts to root:root whenever DD recreates host-services
  // (reboot / DD restart) and `mise run up` reuses the container without
  // re-running postCreate. postStartCommand fires on every `up`, so this
  // is the durable fix for R2 surviving restarts.
  "postStartCommand": "sudo chown ${localEnv:USER}:${localEnv:USER} /run/host-services/ssh-auth.sock",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
      ],
    },
  },
}
