#!/usr/bin/env bash
#MISE description="Configure and build clang-p2996 (hours); a rerun resumes the same build dir"
#MISE depends=["p2996:source"]
#USAGE flag "--dry-run" help="Print the cmake commands only"
set -euo pipefail
. "$(dirname "$0")/common.sh"
unset CC CXX CFLAGS CXXFLAGS CPPFLAGS LDFLAGS SDKROOT
export P2996_SDK="$(realpath "$(xcrun --show-sdk-path)")"
configure=(cmake -S "$SRC/llvm" -B "$BUILD" -G Ninja -C "$HERE/bootstrap.cmake"
  -DCMAKE_C_COMPILER="$(xcrun -f clang)" -DCMAKE_CXX_COMPILER="$(xcrun -f clang++)"
  -DCMAKE_INSTALL_PREFIX="$ROOT/current")
build=(cmake --build "$BUILD" --parallel 4)
# Runs a command under a non-blocking flock on $LOCK (macOS has no flock(1)).
locked() {
  mkdir -p "$(dirname "$LOCK")"
  /usr/bin/perl -MFcntl=:flock -e 'open(my $f, ">>", shift) or die "$!\n";
    flock($f, LOCK_EX | LOCK_NB) or die "p2996:build: another heavy build holds the lock\n";
    system(@ARGV); exit($? & 127 ? 128 + ($? & 127) : $? >> 8)' "$LOCK" "$@"
}
if [ "${usage_dry_run:-false}" = true ]; then
  [ -f "$BUILD/CMakeCache.txt" ] || echo "P2996_SDK=$P2996_SDK ${configure[*]}"
  echo "${build[*]}"
  exit 0
fi
[ -f "$BUILD/CMakeCache.txt" ] || locked "${configure[@]}"
NINJA_STATUS="[%f/%t %es] " locked "${build[@]}"
